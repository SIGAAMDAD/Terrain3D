+/**************************************************************************/
+/*  terrain3d_forward_plus_bridge.h                                       */
+/**************************************************************************/
+
+#pragma once
+
+#include "core/object/object.h"
+#include "core/templates/local_vector.h"
+#include "core/variant/callable.h"
+#include "core/variant/dictionary.h"
+
+#include <atomic>
+#include <mutex>
+
+class Terrain3DForwardPlusBridge : public Object {
+	GDCLASS(Terrain3DForwardPlusBridge, Object);
+
+public:
+	static constexpr int ABI_VERSION = 7;
+
+	enum PassKind {
+		PASS_INVALID = 0,
+		PASS_DEPTH = 1,
+		PASS_OPAQUE = 2,
+		PASS_SHADOW = 3,
+		PASS_MOTION = 4,
+		PASS_MATERIAL = 5,
+		PASS_SDF = 6,
+		PASS_GI = 7,
+		PASS_REFLECTION = 8,
+	};
+
+	enum CallbackPhase {
+		PHASE_PREPARE = 0,
+		PHASE_SUBMIT = 1,
+	};
+
+private:
+	static Terrain3DForwardPlusBridge *singleton;
+
+	struct CallbackSlot {
+		Callable callable;
+		std::atomic_bool active{ true };
+
+		explicit CallbackSlot(const Callable &p_callable) : callable(p_callable) {}
+	};
+
+	std::atomic<CallbackSlot *> callback_slot{ nullptr };
+	mutable std::atomic_uint32_t callback_readers{ 0 };
+	std::mutex callback_mutex;
+	LocalVector<CallbackSlot *> retired_callbacks;
+
+protected:
+	static void _bind_methods();
+
+public:
+	Terrain3DForwardPlusBridge();
+	static Terrain3DForwardPlusBridge *get_singleton() { return singleton; }
+
+	int get_abi_version() const { return ABI_VERSION; }
+	bool register_callback(const Callable &p_callback);
+	bool unregister_callback(const Callable &p_callback);
+	bool has_callback() const;
+
+	// Deletion of an unregistered Callable is deliberately separated from the
+	// renderer-thread pointer exchange. The extension calls force_sync() before
+	// this method so a callback can never outlive the loaded GDExtension.
+	void collect_retired_callbacks();
+
+	// Renderer-only synchronous entry point. The active slot is immutable and
+	// no mutex is acquired by normal Forward+ pass traversal.
+	bool invoke(const Dictionary &p_packet) const;
+
+	~Terrain3DForwardPlusBridge();
+};
+
+VARIANT_ENUM_CAST(Terrain3DForwardPlusBridge::PassKind);
+VARIANT_ENUM_CAST(Terrain3DForwardPlusBridge::CallbackPhase);
