+/**************************************************************************/
+/*  terrain3d_forward_plus_bridge.cpp                                     */
+/**************************************************************************/
+
+#include "terrain3d_forward_plus_bridge.h"
+
+#include "core/object/class_db.h"
+
+Terrain3DForwardPlusBridge *Terrain3DForwardPlusBridge::singleton = nullptr;
+
+Terrain3DForwardPlusBridge::Terrain3DForwardPlusBridge() {
+	ERR_FAIL_COND(singleton != nullptr);
+	singleton = this;
+}
+
+void Terrain3DForwardPlusBridge::_bind_methods() {
+	ClassDB::bind_method(D_METHOD("get_abi_version"), &Terrain3DForwardPlusBridge::get_abi_version);
+	ClassDB::bind_method(D_METHOD("register_callback", "callback"), &Terrain3DForwardPlusBridge::register_callback);
+	ClassDB::bind_method(D_METHOD("unregister_callback", "callback"), &Terrain3DForwardPlusBridge::unregister_callback);
+	ClassDB::bind_method(D_METHOD("has_callback"), &Terrain3DForwardPlusBridge::has_callback);
+	ClassDB::bind_method(D_METHOD("collect_retired_callbacks"), &Terrain3DForwardPlusBridge::collect_retired_callbacks);
+
+	BIND_ENUM_CONSTANT(PASS_INVALID);
+	BIND_ENUM_CONSTANT(PASS_DEPTH);
+	BIND_ENUM_CONSTANT(PASS_OPAQUE);
+	BIND_ENUM_CONSTANT(PASS_SHADOW);
+	BIND_ENUM_CONSTANT(PASS_MOTION);
+	BIND_ENUM_CONSTANT(PASS_MATERIAL);
+	BIND_ENUM_CONSTANT(PASS_SDF);
+	BIND_ENUM_CONSTANT(PASS_GI);
+	BIND_ENUM_CONSTANT(PASS_REFLECTION);
+	BIND_ENUM_CONSTANT(PHASE_PREPARE);
+	BIND_ENUM_CONSTANT(PHASE_SUBMIT);
+}
+
+bool Terrain3DForwardPlusBridge::register_callback(const Callable &p_callback) {
+	ERR_FAIL_COND_V_MSG(!p_callback.is_valid(), false, "Terrain3D Forward+ bridge rejected an invalid callback.");
+	std::lock_guard<std::mutex> lock(callback_mutex);
+	ERR_FAIL_COND_V_MSG(callback_slot.load(std::memory_order_acquire) != nullptr, false, "Terrain3D Forward+ bridge already has a registered callback.");
+
+	CallbackSlot *slot = memnew(CallbackSlot(p_callback));
+	callback_slot.store(slot, std::memory_order_release);
+	return true;
+}
+
+bool Terrain3DForwardPlusBridge::unregister_callback(const Callable &p_callback) {
+	std::lock_guard<std::mutex> lock(callback_mutex);
+	CallbackSlot *slot = callback_slot.load(std::memory_order_acquire);
+	if (slot == nullptr) {
+		return false;
+	}
+	if (slot->callable != p_callback) {
+		return false;
+	}
+
+	CallbackSlot *expected = slot;
+	if (!callback_slot.compare_exchange_strong(expected, nullptr, std::memory_order_acq_rel, std::memory_order_acquire)) {
+		return false;
+	}
+	slot->active.store(false, std::memory_order_release);
+	retired_callbacks.push_back(slot);
+	return true;
+}
+
+bool Terrain3DForwardPlusBridge::has_callback() const {
+	CallbackSlot *slot = callback_slot.load(std::memory_order_acquire);
+	return slot != nullptr && slot->active.load(std::memory_order_acquire);
+}
+
+void Terrain3DForwardPlusBridge::collect_retired_callbacks() {
+	std::lock_guard<std::mutex> lock(callback_mutex);
+	if (callback_readers.load(std::memory_order_acquire) != 0) {
+		return;
+	}
+	for (CallbackSlot *slot : retired_callbacks) {
+		memdelete(slot);
+	}
+	retired_callbacks.clear();
+}
+
+bool Terrain3DForwardPlusBridge::invoke(const Dictionary &p_packet) const {
+	// Increment before loading the slot. An unregistering thread can therefore
+	// reclaim retired slots only after every reader that could have observed
+	// the old pointer has left this synchronous callback.
+	callback_readers.fetch_add(1, std::memory_order_acq_rel);
+	CallbackSlot *slot = callback_slot.load(std::memory_order_acquire);
+	if (slot == nullptr || !slot->active.load(std::memory_order_acquire)) {
+		callback_readers.fetch_sub(1, std::memory_order_release);
+		return false;
+	}
+
+	Variant result = slot->callable.call(p_packet);
+	callback_readers.fetch_sub(1, std::memory_order_release);
+	return result.get_type() != Variant::BOOL || bool(result);
+}
+
+Terrain3DForwardPlusBridge::~Terrain3DForwardPlusBridge() {
+	if (singleton == this) {
+		singleton = nullptr;
+	}
+	CallbackSlot *slot = callback_slot.exchange(nullptr, std::memory_order_acq_rel);
+	if (slot != nullptr) {
+		slot->active.store(false, std::memory_order_release);
+		memdelete(slot);
+	}
+	for (CallbackSlot *retired : retired_callbacks) {
+		memdelete(retired);
+	}
+	retired_callbacks.clear();
+}
