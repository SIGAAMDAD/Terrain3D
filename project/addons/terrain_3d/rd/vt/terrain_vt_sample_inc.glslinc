#ifndef TERRAIN3D_VT_SAMPLE_INC_GLSL
#define TERRAIN3D_VT_SAMPLE_INC_GLSL

#ifndef TERRAIN3D_VT_COMMON_INC_GLSL
#error "terrain_vt_sample_inc.glslinc requires terrain_vt_common_inc.glslinc to be included directly by the shader stage root"
#endif

// Descriptor contract frozen by P18. WG-G may move these bindings as one
// descriptor family, but must preserve the resource semantics and helper API.
layout(set = 0, binding = 8, std430) readonly buffer T3DVTAllocationBuffer {
    T3DVTAllocation t3dVtAllocations[];
};
layout(set = 0, binding = 9, std430) readonly buffer T3DVTPageTableBuffer {
    T3DVTPageEntry t3dVtPageTable[];
};
layout(set = 0, binding = 14, std430) readonly buffer T3DVTTailMetadataBuffer {
    T3DVTTailMetadata t3dVtTails[];
};
layout(set = 0, binding = 10) uniform sampler2DArray t3dVtAlbedoBank0;
layout(set = 0, binding = 11) uniform sampler2DArray t3dVtNormalBank0;
layout(set = 0, binding = 12) uniform sampler2DArray t3dVtSurfaceBank0;
layout(set = 0, binding = 13) uniform sampler2DArray t3dVtHeightBank0;
layout(set = 0, binding = 15) uniform sampler2D t3dVtAlbedoTail;
layout(set = 0, binding = 16) uniform sampler2D t3dVtNormalTail;
layout(set = 0, binding = 17) uniform sampler2D t3dVtSurfaceTail;
layout(set = 0, binding = 18) uniform sampler2D t3dVtHeightTail;
layout(set = 0, binding = 19, std430) readonly buffer T3DVTMipLayoutBuffer {
    T3DVTMipLayout t3dVtMipLayouts[];
};

struct T3DVTSampleMaterial {
    vec4 albedo;
    vec4 normal;
    vec4 surface;
    float height;
};

bool t3d_vt_get_mip_layout(uint allocationId, uint mip, out T3DVTMipLayout mipLayout) {
    mipLayout.baseVirtualPage = T3D_VT_INVALID_PAGE;
    mipLayout.packedExtent = 0u;
    if (mip >= T3D_VT_MAX_MIPS) {
        return false;
    }
    mipLayout = t3dVtMipLayouts[t3d_vt_mip_layout_index(allocationId, mip)];
    return mipLayout.baseVirtualPage != T3D_VT_INVALID_PAGE && t3d_vt_mip_layout_width(mipLayout) != 0u
        && t3d_vt_mip_layout_height(mipLayout) != 0u;
}

bool t3d_vt_compute_page(uint allocationId, T3DVTAllocation allocation, uint mip, uvec2 pageCoord, out uint virtualPage) {
    T3DVTMipLayout mipLayout;
    if (mip >= t3d_vt_allocation_mip_count(allocation) || !t3d_vt_get_mip_layout(allocationId, mip, mipLayout)) {
        virtualPage = T3D_VT_INVALID_PAGE;
        return false;
    }
    uint width = t3d_vt_mip_layout_width(mipLayout);
    uint height = t3d_vt_mip_layout_height(mipLayout);
    if (pageCoord.x >= width || pageCoord.y >= height) {
        virtualPage = T3D_VT_INVALID_PAGE;
        return false;
    }
    virtualPage = mipLayout.baseVirtualPage + pageCoord.y * width + pageCoord.x;
    return virtualPage >= allocation.baseVirtualPage && virtualPage < allocation.baseVirtualPage + allocation.pageCount;
}

bool t3d_vt_resolve_page_core(
    uint allocationId, uint requestedPage, uint requestedMip, uint allocationCount, uint pageCount, out T3DVTResolveResult result);

bool t3d_vt_resolve_page(
    uint allocationId, uint requestedPage, uint requestedMip, uint allocationCount, uint pageCount, out T3DVTResolveResult result) {
    return t3d_vt_resolve_page_core(allocationId, requestedPage, requestedMip, allocationCount, pageCount, result);
}

vec4 t3d_vt_sample_albedo_bank(uint bank, uint layer, vec2 uv) {
    return bank == 0u ? t3d_vt_decode_srgb_albedo(texture(t3dVtAlbedoBank0, vec3(uv, float(layer)))) : vec4(1.0);
}

vec4 t3d_vt_sample_physical_family_v3(uint family, uint layer, vec2 uv) {
    if (family == T3D_VT_PHYSICAL_FORMAT_BC1_UNORM) return texture(t3dVtAlbedoBank0, vec3(uv, float(layer)));
    if (family == T3D_VT_PHYSICAL_FORMAT_BC7_UNORM) return texture(t3dVtSurfaceBank0, vec3(uv, float(layer)));
    if (family == T3D_VT_PHYSICAL_FORMAT_BC5_UNORM) return texture(t3dVtNormalBank0, vec3(uv, float(layer)));
    if (family == T3D_VT_PHYSICAL_FORMAT_R8_UNORM) return texture(t3dVtHeightBank0, vec3(uv, float(layer)));
    return vec4(1.0);
}

vec4 t3d_vt_sample_normal_bank(uint bank, uint layer, vec2 uv) {
    return bank == 0u ? texture(t3dVtNormalBank0, vec3(uv, float(layer))) : vec4(0.5, 0.5, 1.0, 1.0);
}

vec4 t3d_vt_sample_surface_bank(uint bank, uint layer, vec2 uv) {
    return bank == 0u ? texture(t3dVtSurfaceBank0, vec3(uv, float(layer))) : vec4(1.0);
}

float t3d_vt_sample_height_bank(uint bank, uint layer, vec2 uv) {
    return bank == 0u ? texture(t3dVtHeightBank0, vec3(uv, float(layer))).r : float(T3D_VT_NEUTRAL_HEIGHT8) / 255.0;
}

vec2 t3d_vt_physical_uv(T3DVTResolveResult result, vec2 wrappedUv) {
    T3DVTMipLayout mipLayout = t3dVtMipLayouts[t3d_vt_mip_layout_index(result.allocation, t3d_vt_resolve_resolved_mip(result))];
    uint width = max(t3d_vt_mip_layout_width(mipLayout), 1u);
    uint height = max(t3d_vt_mip_layout_height(mipLayout), 1u);
    vec2 local = fract(wrappedUv * vec2(float(width), float(height)));
    return (vec2(float(T3D_VT_PAGE_GUTTER)) + local * float(T3D_VT_PAGE_INTERIOR)) / float(T3D_VT_PHYSICAL_TILE);
}

vec2 t3d_vt_tail_uv(T3DVTTailMetadata tail, uint resolvedMip, vec2 wrappedUv, ivec2 atlasSize) {
    uint tailFirstMip = t3d_vt_tail_first_mip(tail);
    uint tailMipCount = max(t3d_vt_tail_mip_count(tail), 1u);
    uint tailDelta = min(resolvedMip >= tailFirstMip ? resolvedMip - tailFirstMip : 0u, tailMipCount - 1u);
    uint firstWidth = max(t3d_vt_tail_width(tail), 1u);
    uint firstHeight = max(t3d_vt_tail_height(tail), 1u);
    uint mipX = 0u;
    for (uint i = 0u; i < T3D_VT_MAX_MIPS; ++i) {
        if (i >= tailDelta) break;
        mipX += max(firstWidth >> i, 1u);
    }
    vec2 extent = vec2(float(max(firstWidth >> tailDelta, 1u)), float(max(firstHeight >> tailDelta, 1u)));
    vec2 texel = vec2(float(tail.atlasX + mipX), float(tail.atlasY)) + vec2(0.5) + wrappedUv * max(extent - vec2(1.0), vec2(0.0));
    return texel / vec2(atlasSize);
}

vec4 t3d_vt_sample_albedo(T3DVTAllocation allocation, T3DVTResolveResult result, vec2 wrappedUv) {
    uint flags = t3d_vt_resolve_flags(result);
    if ((flags & T3D_VT_RESOLVE_PHYSICAL) != 0u) {
        return t3d_vt_sample_albedo_bank(
            0u, t3d_vt_v3_physical_slot(result.physicalSlot), t3d_vt_physical_uv(result, wrappedUv));
    }
    if ((flags & T3D_VT_RESOLVE_TAIL) != 0u) {
        T3DVTTailMetadata tail = t3dVtTails[result.tailIndex];
        if ((tail.channelMask & (1u << T3D_VT_PHYSICAL_FORMAT_BC1_UNORM)) != 0u) {
            return t3d_vt_decode_srgb_albedo(textureLod(t3dVtAlbedoTail,
                t3d_vt_tail_uv(tail, t3d_vt_resolve_resolved_mip(result), wrappedUv, textureSize(t3dVtAlbedoTail, 0)), 0.0));
        }
    }
    return vec4(1.0);
}

vec4 t3d_vt_sample_normal(T3DVTAllocation allocation, T3DVTResolveResult result, vec2 wrappedUv) {
    uint flags = t3d_vt_resolve_flags(result);
    if ((flags & T3D_VT_RESOLVE_PHYSICAL) != 0u) {
        return t3d_vt_sample_normal_bank(
            0u, t3d_vt_v3_physical_slot(result.physicalSlot), t3d_vt_physical_uv(result, wrappedUv));
    }
    if ((flags & T3D_VT_RESOLVE_TAIL) != 0u) {
        T3DVTTailMetadata tail = t3dVtTails[result.tailIndex];
        if ((tail.channelMask & (1u << T3D_VT_PHYSICAL_FORMAT_BC5_UNORM)) != 0u) {
            return textureLod(t3dVtNormalTail,
                t3d_vt_tail_uv(tail, t3d_vt_resolve_resolved_mip(result), wrappedUv, textureSize(t3dVtNormalTail, 0)), 0.0);
        }
    }
    return vec4(0.5, 0.5, 1.0, 1.0);
}

vec4 t3d_vt_sample_surface(T3DVTAllocation allocation, T3DVTResolveResult result, vec2 wrappedUv) {
    uint flags = t3d_vt_resolve_flags(result);
    if ((flags & T3D_VT_RESOLVE_PHYSICAL) != 0u) {
        return t3d_vt_sample_surface_bank(
            0u, t3d_vt_v3_physical_slot(result.physicalSlot), t3d_vt_physical_uv(result, wrappedUv));
    }
    if ((flags & T3D_VT_RESOLVE_TAIL) != 0u) {
        T3DVTTailMetadata tail = t3dVtTails[result.tailIndex];
        if ((tail.channelMask & (1u << T3D_VT_PHYSICAL_FORMAT_BC7_UNORM)) != 0u) {
            return textureLod(t3dVtSurfaceTail,
                t3d_vt_tail_uv(tail, t3d_vt_resolve_resolved_mip(result), wrappedUv, textureSize(t3dVtSurfaceTail, 0)), 0.0);
        }
    }
    return vec4(1.0);
}

float t3d_vt_sample_height(T3DVTAllocation allocation, T3DVTResolveResult result, vec2 wrappedUv) {
    uint flags = t3d_vt_resolve_flags(result);
    if ((flags & T3D_VT_RESOLVE_PHYSICAL) != 0u) {
        return t3d_vt_sample_height_bank(
            0u, t3d_vt_v3_physical_slot(result.physicalSlot), t3d_vt_physical_uv(result, wrappedUv));
    }
    if ((flags & T3D_VT_RESOLVE_TAIL) != 0u) {
        T3DVTTailMetadata tail = t3dVtTails[result.tailIndex];
        if ((tail.channelMask & (1u << T3D_VT_PHYSICAL_FORMAT_R8_UNORM)) != 0u) {
            return textureLod(t3dVtHeightTail,
                t3d_vt_tail_uv(tail, t3d_vt_resolve_resolved_mip(result), wrappedUv, textureSize(t3dVtHeightTail, 0)), 0.0).r;
        }
    }
    return float(T3D_VT_NEUTRAL_HEIGHT8) / 255.0;
}

bool t3d_vt_sample_material(uint allocationId,
    vec2 uv,
    bool repeatUv,
    uint allocationCount,
    uint pageCount,
    out T3DVTSampleMaterial material,
    out T3DVTResolveResult result) {
    material.albedo = vec4(1.0);
    material.normal = vec4(0.5, 0.5, 1.0, 1.0);
    material.surface = vec4(1.0);
    material.height = float(T3D_VT_NEUTRAL_HEIGHT8) / 255.0;
    if (allocationId == T3D_VT_INVALID_ALLOCATION || allocationId >= allocationCount) {
        return false;
    }
    T3DVTAllocation allocation = t3dVtAllocations[allocationId];
    uint mipCount = t3d_vt_allocation_mip_count(allocation);
    if (!t3d_vt_allocation_quality_enabled(allocation)) return false;
    uint baseMip = min(t3d_vt_allocation_quality_base_mip(allocation), max(mipCount, 1u) - 1u);
    uint mip0Width = t3d_vt_allocation_mip0_width(allocation);
    uint mip0Height = t3d_vt_allocation_mip0_height(allocation);
    if (mipCount == 0u || mip0Width == 0u || mip0Height == 0u || allocation.pageCount == 0u) {
        return false;
    }
    vec2 wrapped = repeatUv ? fract(uv) : clamp(uv, vec2(0.0), vec2(0.999999));
    T3DVTMipLayout qualityBaseLayout;
    if (!t3d_vt_get_mip_layout(allocationId, baseMip, qualityBaseLayout)) return false;
    vec2 virtualTexels = vec2(float(t3d_vt_mip_layout_width(qualityBaseLayout) * T3D_VT_PAGE_INTERIOR),
        float(t3d_vt_mip_layout_height(qualityBaseLayout) * T3D_VT_PAGE_INTERIOR));
    vec2 dx = dFdx(uv * virtualTexels);
    vec2 dy = dFdy(uv * virtualTexels);
    float rho = max(length(dx), length(dy));
    uint requestedMip = baseMip + uint(clamp(floor(log2(max(rho, 1.0))), 0.0, float(mipCount - baseMip - 1u)));
    T3DVTMipLayout requestedLayout;
    if (!t3d_vt_get_mip_layout(allocationId, requestedMip, requestedLayout)) {
        return false;
    }
    uint width = t3d_vt_mip_layout_width(requestedLayout);
    uint height = t3d_vt_mip_layout_height(requestedLayout);
    uvec2 pageCoord =
        uvec2(min(uint(floor(wrapped.x * float(width))), width - 1u), min(uint(floor(wrapped.y * float(height))), height - 1u));
    uint requestedPage = T3D_VT_INVALID_PAGE;
    if (!t3d_vt_compute_page(allocationId, allocation, requestedMip, pageCoord, requestedPage)
        || !t3d_vt_resolve_page(allocationId, requestedPage, requestedMip, allocationCount, pageCount, result)) {
        return false;
    }
    uint flags = t3d_vt_resolve_flags(result);
    if ((flags & T3D_VT_RESOLVE_PHYSICAL) != 0u) {
        vec2 sampleUv = t3d_vt_physical_uv(result, wrapped);
        uint bank = 0u;
        uint layer = t3d_vt_v3_physical_slot(result.physicalSlot);
        material.albedo = t3d_vt_sample_albedo_bank(bank, layer, sampleUv);
        material.normal = t3d_vt_sample_normal_bank(bank, layer, sampleUv);
        material.surface = t3d_vt_sample_surface_bank(bank, layer, sampleUv);
        material.height = t3d_vt_sample_height_bank(bank, layer, sampleUv);
        return true;
    }
    if ((flags & T3D_VT_RESOLVE_TAIL) != 0u && result.tailIndex != T3D_VT_INVALID_TAIL) {
        T3DVTTailMetadata tail = t3dVtTails[result.tailIndex];
        vec2 sampleUv = t3d_vt_tail_uv(
            tail, t3d_vt_resolve_resolved_mip(result), wrapped, textureSize(t3dVtAlbedoTail, 0));
        uint mask = tail.channelMask;
        if ((mask & (1u << T3D_VT_CHANNEL_ALBEDO)) != 0u)
            material.albedo = t3d_vt_decode_srgb_albedo(textureLod(t3dVtAlbedoTail, sampleUv, 0.0));
        if ((mask & (1u << T3D_VT_CHANNEL_NORMAL)) != 0u) material.normal = textureLod(t3dVtNormalTail, sampleUv, 0.0);
        if ((mask & (1u << T3D_VT_CHANNEL_SURFACE)) != 0u) material.surface = textureLod(t3dVtSurfaceTail, sampleUv, 0.0);
        if ((mask & (1u << T3D_VT_CHANNEL_HEIGHT)) != 0u) material.height = textureLod(t3dVtHeightTail, sampleUv, 0.0).r;
        return true;
    }
    return false;
}

void t3d_vt_debug_outputs(T3DVTResolveResult result, out uvec4 primary, out uvec4 secondary) {
    primary = uvec4(result.allocation, result.requestedPage, result.resolvedPage, result.physicalSlot);
    secondary = uvec4(
        result.tailIndex, t3d_vt_resolve_requested_mip(result), t3d_vt_resolve_resolved_mip(result), t3d_vt_resolve_fallback_depth(result));
}

#endif // TERRAIN3D_VT_SAMPLE_INC_GLSL
