#ifndef TERRAIN3D_VT_RESOLVE_CORE_GLSL
#define TERRAIN3D_VT_RESOLVE_CORE_GLSL

#ifndef T3D_VT_RESOLVE_ALLOCATION
#error "terrain_vt_resolve_core.glslinc requires T3D_VT_RESOLVE_ALLOCATION(index)"
#endif
#ifndef T3D_VT_RESOLVE_PAGE_ENTRY
#error "terrain_vt_resolve_core.glslinc requires T3D_VT_RESOLVE_PAGE_ENTRY(index)"
#endif
#ifndef T3D_VT_RESOLVE_TAIL_ENTRY
#error "terrain_vt_resolve_core.glslinc requires T3D_VT_RESOLVE_TAIL_ENTRY(index)"
#endif

bool t3d_vt_resolve_tail_core(
    T3DVTAllocation allocation, uint allocationCount, uint requestedMip, uint fallbackDepth, inout T3DVTResolveResult result) {
    if (allocation.tailIndex == T3D_VT_INVALID_TAIL || allocation.tailIndex >= allocationCount) {
        return false;
    }
    T3DVTTailMetadata tail = T3D_VT_RESOLVE_TAIL_ENTRY(allocation.tailIndex);
    uint allocationMipCount = min(t3d_vt_allocation_mip_count(allocation), T3D_VT_MAX_MIPS);
    uint tailFirstMip = t3d_vt_tail_first_mip(tail);
    uint tailMipCount = t3d_vt_tail_mip_count(tail);
    if (tail.generation != allocation.generation || t3d_vt_tail_width(tail) == 0u || t3d_vt_tail_height(tail) == 0u || tailMipCount == 0u
        || tailFirstMip >= allocationMipCount || tailMipCount > allocationMipCount - tailFirstMip) {
        return false;
    }
    result.tailIndex = allocation.tailIndex;
    uint tailLastMip = tailFirstMip + tailMipCount - 1u;
    t3d_vt_resolve_set_resolved_mip(result, clamp(requestedMip, tailFirstMip, tailLastMip));
    t3d_vt_resolve_set_fallback_flags(result, fallbackDepth, T3D_VT_RESOLVE_TAIL);
    return true;
}

bool t3d_vt_resolve_page_core(
    uint allocationId, uint requestedPage, uint requestedMip, uint allocationCount, uint pageCount, out T3DVTResolveResult result) {
    result.allocation = allocationId;
    result.requestedPage = requestedPage;
    result.resolvedPage = T3D_VT_INVALID_PAGE;
    result.physicalSlot = T3D_VT_INVALID_SLOT;
    result.tailIndex = T3D_VT_INVALID_TAIL;
    result.packedRequestedResolvedMip = 0u;
    result.packedFallbackDepthFlags = 0u;
    result.reserved = 0u;
    t3d_vt_resolve_set_requested_mip(result, requestedMip);
    if (allocationId >= allocationCount || requestedPage >= pageCount) {
        return false;
    }
    T3DVTAllocation allocation = T3D_VT_RESOLVE_ALLOCATION(allocationId);
    uint allocationMipCount = min(t3d_vt_allocation_mip_count(allocation), T3D_VT_MAX_MIPS);
    if (!t3d_vt_allocation_quality_enabled(allocation) || allocation.pageCount == 0u || allocationMipCount == 0u || requestedMip >= allocationMipCount || allocation.baseVirtualPage >= pageCount
        || allocation.pageCount > pageCount - allocation.baseVirtualPage) {
        return false;
    }
    uint allocationEnd = allocation.baseVirtualPage + allocation.pageCount;
    if (requestedPage < allocation.baseVirtualPage || requestedPage >= allocationEnd) {
        return false;
    }

    // Tail metadata is static for the allocation. Mips owned by the compact tail
    // never need an ancestor walk at all.
    if (allocation.tailIndex != T3D_VT_INVALID_TAIL && allocation.tailIndex < allocationCount) {
        T3DVTTailMetadata tail = T3D_VT_RESOLVE_TAIL_ENTRY(allocation.tailIndex);
        uint tailFirstMip = t3d_vt_tail_first_mip(tail);
        if (tail.generation == allocation.generation && requestedMip >= tailFirstMip && tailFirstMip < allocationMipCount) {
            return t3d_vt_resolve_tail_core(allocation, allocationCount, requestedMip, 0u, result);
        }
    }

    uint page = requestedPage;
    uint fallbackDepth = 0u;
    // There cannot be more useful ancestors than remaining allocation mips.
    uint probeCap = min(T3D_VT_ANCESTOR_PROBE_CAP, allocationMipCount - requestedMip);
    for (uint probe = 0u; probe < probeCap; ++probe) {
        if (page < allocation.baseVirtualPage || page >= allocationEnd || page >= pageCount) {
            return false;
        }
        T3DVTPageEntry entry = T3D_VT_RESOLVE_PAGE_ENTRY(page);
        uint flags = t3d_vt_page_flags(entry);
        if ((flags & T3D_VT_PAGE_VALID) == 0u || entry.generation != allocation.generation) {
            return false;
        }
        if ((flags & T3D_VT_PAGE_RESIDENT) != 0u && entry.physicalSlot != T3D_VT_INVALID_SLOT) {
            uint resolveFlags = T3D_VT_RESOLVE_PHYSICAL;
            if (fallbackDepth != 0u) {
                resolveFlags |= T3D_VT_RESOLVE_ANCESTOR;
            }
            result.resolvedPage = page;
            result.physicalSlot = entry.physicalSlot;
            t3d_vt_resolve_set_resolved_mip(result, t3d_vt_page_resolved_mip(entry));
            t3d_vt_resolve_set_fallback_flags(result, fallbackDepth, resolveFlags);
            return true;
        }
        // Root/tail-fallback pages are explicit terminal metadata. Do not perform
        // another dependent page-table read once the chain has reached one.
        if ((flags & T3D_VT_PAGE_TAIL_FALLBACK) != 0u || entry.parentPage == T3D_VT_INVALID_PAGE) {
            return t3d_vt_resolve_tail_core(allocation, allocationCount, requestedMip, fallbackDepth, result);
        }
        page = entry.parentPage;
        fallbackDepth = min(fallbackDepth + 1u, 0xffffu);
    }
    return t3d_vt_resolve_tail_core(allocation, allocationCount, requestedMip, fallbackDepth, result);
}

#endif
