#ifndef TERRAIN3D_FORWARD_LIGHTING_INC_GLSL
#define TERRAIN3D_FORWARD_LIGHTING_INC_GLSL

// SH-B shared contract: Forward+ native lighting owns descriptor set 2 with
// bindings 0..15. CPU construction is frozen in
// terrain_3d_rd_forward_lighting.h/.cpp; consumer shaders must not remap it.
#define T3D_FORWARD_LIGHTING_SHARED_CONTRACT_VERSION 1u

#if defined(T3D_FORWARD_NATIVE_LIGHTING) && !defined(T3D_FORWARD_DEPTH)
// WG-G P14: pipeline-specialized lighting state. IDs 25/26 extend WG-C's
// material feature constant at ID 24 without duplicating RDShaderFile roots.
const uint T3D_LIGHTING_MODEL_RUNTIME = 0xffu;
const uint T3D_SCENE_INTEGRATION_DYNAMIC = 0u;
const uint T3D_SCENE_INTEGRATION_NONE = 1u;
#if T3D_TERRAIN_SHADER_PATH == 0
layout(constant_id = 25) const uint t3d_lighting_model_class = T3D_LIGHTING_MODEL_RUNTIME;
layout(constant_id = 26) const uint t3d_scene_integration_class = T3D_SCENE_INTEGRATION_DYNAMIC;
#endif

uint t3d_forward_lighting_model(uint runtime_model) {
#if T3D_TERRAIN_SHADER_PATH == 0
    if (t3d_lighting_model_class != T3D_LIGHTING_MODEL_RUNTIME) {
        return t3d_lighting_model_class;
    }
#endif
    return runtime_model;
}
// GL_EXT_samplerless_texture_functions is enabled by each consuming stage
// root before this include. Godot RDShaderFile expands filesystem includes
// only one level deep, so extension ownership must remain at the root.
// Godot 4.7.2 Forward+ light-buffer ABI. Keep field order synchronized with
// servers/rendering/renderer_rd/shaders/light_data_inc.glsl.
struct T3DNativeLightData {
    vec3 position;
    float inv_radius;
    vec3 direction;
    float size;
    vec3 color;
    float attenuation;
    vec3 area_width;
    float cone_attenuation;
    vec3 area_height;
    float cone_angle;
    float specular_amount;
    float shadow_opacity;
    float pad0;
    float pad1;
    vec4 atlas_rect;
    // Four vec4 columns have the same std430 memory layout as a column-major
    // mat4, without importing a matrix-layout decoration into Function structs.
    vec4 shadow_column0;
    vec4 shadow_column1;
    vec4 shadow_column2;
    vec4 shadow_column3;
    float shadow_bias;
    float shadow_normal_bias;
    float transmittance_bias;
    float soft_shadow_size;
    float soft_shadow_scale;
    uint mask;
    float volumetric_fog_energy;
    uint bake_mode;
    vec4 projector_rect;
};

struct T3DNativeDirectionalLightData {
    vec3 direction;
    float energy;
    vec3 color;
    float size;
    float specular;
    uint mask;
    float softshadow_angle;
    float soft_shadow_scale;
    uint blend_splits;
    float shadow_opacity;
    float fade_from;
    float fade_to;
    uvec2 pad;
    uint bake_mode;
    float volumetric_fog_energy;
    vec4 shadow_bias;
    vec4 shadow_normal_bias;
    vec4 shadow_transmittance_bias;
    vec4 shadow_z_range;
    vec4 shadow_range_begin;
    vec4 shadow_split_offsets;
    mat4 shadow_matrix1;
    mat4 shadow_matrix2;
    mat4 shadow_matrix3;
    mat4 shadow_matrix4;
    vec2 uv_scale1;
    vec2 uv_scale2;
    vec2 uv_scale3;
    vec2 uv_scale4;
};

layout(set = 2, binding = 0, std140) uniform T3DForwardLightFrame {
    uvec4 cluster_params; // shift, width, type size, max element words
    uvec4 scene_params;   // directional count, default mask, shadow flags, directional soft-shadow flag
    vec4 depth_params;    // z near, z far, inverse z far, reserved
    uvec4 render_params;  // width, height, max cluster elements, reserved
    vec4 ambient_light_color_energy;
    vec4 environment_params0; // ambient sky mix, emissive exposure, IBL exposure, radiance pixel size
    vec4 environment_params1; // radiance octahedral border size, reserved
    mat3 radiance_inverse_xform;
}
t3d_forward_light_frame;
layout(set = 2, binding = 1, std140) uniform T3DDirectionalLights {
    T3DNativeDirectionalLightData data[8];
}
t3d_directional_lights;
#ifndef T3D_FORWARD_ONE_SUN
layout(set = 2, binding = 2, std430) readonly buffer T3DOmniLights {
    T3DNativeLightData data[];
}
t3d_omni_lights;
layout(set = 2, binding = 3, std430) readonly buffer T3DSpotLights {
    T3DNativeLightData data[];
}
t3d_spot_lights;
layout(set = 2, binding = 4, std430) readonly buffer T3DAreaLights {
    T3DNativeLightData data[];
}
t3d_area_lights;
layout(set = 2, binding = 5, std430) readonly buffer T3DClusterBuffer {
    uint data[];
}
t3d_cluster_buffer;
#endif
layout(set = 2, binding = 6) uniform sampler t3d_shadow_sampler;
#ifndef T3D_FORWARD_ONE_SUN
layout(set = 2, binding = 7) uniform texture2D t3d_shadow_atlas;
#endif
layout(set = 2, binding = 8) uniform texture2D t3d_directional_shadow_atlas;

// Godot 4.7.2 scene-integration ABI used by F6. These layouts mirror
// light_data_inc.glsl/decal_data_inc.glsl and are borrowed, never owned here.
struct T3DNativeReflectionData {
    vec3 box_extents;
    float index;
    vec3 box_offset;
    uint mask;
    vec3 ambient;
    float intensity;
    float blend_distance;
    uint exterior;
    uint box_project;
    uint ambient_mode;
    float exposure_normalization;
    float pad0;
    float pad1;
    float pad2;
    mat4 local_matrix;
};

struct T3DNativeDecalData {
    mat4 xform;
    vec3 inv_extents;
    float albedo_mix;
    vec4 albedo_rect;
    vec4 normal_rect;
    vec4 orm_rect;
    vec4 emission_rect;
    vec4 modulate;
    float emission_energy;
    uint mask;
    float upper_fade;
    float lower_fade;
    mat3x4 normal_xform;
    vec3 normal;
    float normal_fade;
};

#ifndef T3D_FORWARD_ONE_SUN
layout(set = 2, binding = 9, std430) readonly buffer T3DReflectionProbes {
    T3DNativeReflectionData data[];
}
t3d_reflections;
layout(set = 2, binding = 10) uniform texture2DArray t3d_reflection_atlas;
layout(set = 2, binding = 11, std430) readonly buffer T3DDecals {
    T3DNativeDecalData data[];
}
t3d_decals;
layout(set = 2, binding = 12) uniform texture2D t3d_decal_atlas;
layout(set = 2, binding = 13) uniform texture2D t3d_decal_atlas_srgb;
#endif
layout(set = 2, binding = 14) uniform sampler t3d_scene_sampler;
#ifdef T3D_FORWARD_RADIANCE_ARRAY
layout(set = 2, binding = 15) uniform texture2DArray t3d_radiance_octmap;
#else
layout(set = 2, binding = 15) uniform texture2D t3d_radiance_octmap;
#endif

const uint T3D_SCENE_FEATURE_REFLECTIONS = 1u;
const uint T3D_SCENE_FEATURE_DECALS = 2u;
const uint T3D_SCENE_FEATURE_AMBIENT_LIGHT = 4u;
const uint T3D_SCENE_FEATURE_AMBIENT_CUBEMAP = 8u;
const uint T3D_SCENE_FEATURE_REFLECTION_CUBEMAP = 16u;
const uint T3D_SCENE_FEATURE_RADIANCE_ARRAY = 32u;
const uint T3D_CLUSTER_TYPE_DECAL = 3u;
const uint T3D_CLUSTER_TYPE_REFLECTION = 4u;

const float T3D_PI = 3.14159265358979323846;

float t3d_native_attenuation(float distance_to_light, float inv_range, float decay) {
    float nd = distance_to_light * inv_range;
    nd *= nd;
    nd *= nd;
    nd = max(1.0 - nd, 0.0);
    // P49: outside the light radius, the quartic falloff is exactly zero;
    // avoid the reciprocal power in the attenuation hot path.
    if (nd == 0.0) return 0.0;
    nd *= nd;
    return nd * pow(max(distance_to_light, 0.0001), -decay);
}

uint t3d_cluster_range_mask(uint word_index, uint item_min, uint item_max) {
    int item_min_i = int(item_min);
    int local_min = clamp(item_min_i - int(word_index) * 32, 0, 31);
    int mask_width = min(int(item_max) - item_min_i, 32 - local_min);
    return mask_width > 0 ? bitfieldInsert(0u, 0xffffffffu, local_min, mask_width) : 0u;
}

struct T3DClusterAddress {
    uint valid;
    uint cluster_offset;
    uint cluster_type_size;
    uint max_words;
    uint cluster_z;
};

struct T3DForwardShadingContext {
    vec3 view_position;
    vec3 view_normal;
    vec3 view_direction;
#ifndef T3D_FORWARD_ONE_SUN
    T3DClusterAddress cluster_address;
#endif
};

#ifndef T3D_FORWARD_ONE_SUN
T3DClusterAddress t3d_cluster_address(vec3 view_position) {
    T3DClusterAddress address;
    address.valid = 0u;
    address.cluster_offset = 0u;
    address.cluster_type_size = t3d_forward_light_frame.cluster_params.z;
    address.max_words = t3d_forward_light_frame.cluster_params.w;
    address.cluster_z = 0u;
    uint cluster_shift = t3d_forward_light_frame.cluster_params.x;
    uint cluster_width = t3d_forward_light_frame.cluster_params.y;
    if (cluster_width == 0u || address.cluster_type_size == 0u || address.max_words == 0u
        || t3d_forward_light_frame.depth_params.y <= 0.0) {
        return address;
    }
    uint stride = address.max_words + 32u;
    uint cluster_count = address.cluster_type_size / stride;
    uint cluster_height = cluster_count / cluster_width;
    uvec2 cluster_pos = uvec2(gl_FragCoord.xy) >> cluster_shift;
    if (cluster_pos.x >= cluster_width || cluster_pos.y >= cluster_height) {
        return address;
    }
    address.cluster_offset = (cluster_width * cluster_pos.y + cluster_pos.x) * stride;
    address.cluster_z = uint(clamp((-view_position.z * t3d_forward_light_frame.depth_params.z) * 32.0, 0.0, 31.0));
    address.valid = 1u;
    return address;
}
#endif

T3DForwardShadingContext t3d_forward_make_shading_context(vec3 view_position, vec3 view_normal) {
    T3DForwardShadingContext context;
    context.view_position = view_position;
    context.view_normal = view_normal;
    context.view_direction = normalize(-view_position);
#ifndef T3D_FORWARD_ONE_SUN
    context.cluster_address = t3d_cluster_address(view_position);
#endif
    return context;
}

#ifndef T3D_FORWARD_ONE_SUN
bool t3d_cluster_range(T3DClusterAddress address,
    uint type_index,
    out uint type_offset,
    out uint item_min,
    out uint item_max,
    out uint item_from,
    out uint item_to) {
    if (address.valid == 0u) {
        return false;
    }
    type_offset = address.cluster_offset + address.cluster_type_size * type_index;
    // Standard per-fragment cluster-depth record fetch.
    const uint record_index = type_offset + address.max_words + address.cluster_z;
    const uint item_min_max = t3d_cluster_buffer.data[record_index];
    item_min = item_min_max & 0xffffu;
    item_max = item_min_max >> 16u;
    item_from = min(item_min >> 5u, address.max_words);
    item_to = min(item_max == 0u ? 0u : ((item_max - 1u) >> 5u) + 1u, address.max_words);
    return item_to > item_from;
}


#if defined(T3D_FORWARD_COMPACT_CLUSTER_LISTS) && T3D_FORWARD_COMPACT_CLUSTER_LISTS
// Optional set-4 sidecar. set-2 native descriptors remain untouched.
layout(set = 4, binding = 0, std430) readonly buffer T3DBr21CompactHeaders { uvec4 records[]; } t3d_br21_headers;
layout(set = 4, binding = 1, std430) readonly buffer T3DBr21CompactIndices { uint indices[]; } t3d_br21_indices;
#define T3D_FORWARD_COMPACT_VALID 0x42523131u
struct T3DBr21Cursor {
    uint word;
    uint last_word;
    uint mask;
    uint base;
    uint min_item;
    uint max_item;
    uint compact_offset;
    uint compact_count;
    uint compact_position;
    bool compact;
};
bool t3d_br21_cursor_begin(T3DClusterAddress address, uint type_index, out T3DBr21Cursor cursor) {
    cursor.word = 0u;
    cursor.last_word = 0u;
    cursor.mask = 0u;
    cursor.base = 0u;
    cursor.min_item = 0u;
    cursor.max_item = 0u;
    cursor.compact_offset = 0u;
    cursor.compact_count = 0u;
    cursor.compact_position = 0u;
    cursor.compact = false;
    uint base, first, last, from, to;
    if (!t3d_cluster_range(address, type_index, base, first, last, from, to))
        return false;
    cursor.base = base;
    cursor.word = from;
    cursor.last_word = to;
    cursor.min_item = first;
    cursor.max_item = last;
    uint stride = address.max_words + 32u;
    uint cluster_index = address.cluster_offset / stride;
    uint header_index = cluster_index * 160u + type_index * 32u + address.cluster_z;
    if (header_index < t3d_br21_headers.records.length()) {
        uvec4 header = t3d_br21_headers.records[header_index];
        if (header.z == T3D_FORWARD_COMPACT_VALID &&
            header.x <= t3d_br21_indices.indices.length() &&
            header.y <= t3d_br21_indices.indices.length() - header.x) {
            cursor.compact = true;
            cursor.compact_offset = header.x;
            cursor.compact_count = header.y;
        }
    }
    return true;
}
bool t3d_br21_cursor_next(inout T3DBr21Cursor cursor, out uint index) {
    if (cursor.compact) {
        if (cursor.compact_position >= cursor.compact_count) return false;
        index = t3d_br21_indices.indices[cursor.compact_offset + cursor.compact_position++];
        return true;
    }
    while (cursor.mask == 0u && cursor.word < cursor.last_word) {
        cursor.mask = t3d_cluster_buffer.data[cursor.base + cursor.word] &
            t3d_cluster_range_mask(cursor.word, cursor.min_item, cursor.max_item);
        cursor.word++;
    }
    if (cursor.mask == 0u) return false;
    uint bit = uint(findMSB(cursor.mask));
    cursor.mask &= ~(1u << bit);
    index = (cursor.word - 1u) * 32u + bit;
    return true;
}
#endif // T3D_FORWARD_COMPACT_CLUSTER_LISTS

#endif

float t3d_shadow_compare(texture2D shadow_texture, vec3 coord) {
    return texture(sampler2DShadow(shadow_texture, t3d_shadow_sampler), coord);
}

float t3d_shadow_pcf_with_inv_size(texture2D shadow_texture, vec3 coord, float scale, vec2 inv_size) {
    if (scale <= 0.0) {
        return t3d_shadow_compare(shadow_texture, coord);
    }
    vec2 texel = scale * inv_size;
    float shadow = 0.0;
    shadow += t3d_shadow_compare(shadow_texture, vec3(coord.xy + texel * vec2(-0.5, -0.5), coord.z));
    shadow += t3d_shadow_compare(shadow_texture, vec3(coord.xy + texel * vec2(0.5, -0.5), coord.z));
    shadow += t3d_shadow_compare(shadow_texture, vec3(coord.xy + texel * vec2(-0.5, 0.5), coord.z));
    shadow += t3d_shadow_compare(shadow_texture, vec3(coord.xy + texel * vec2(0.5, 0.5), coord.z));
    return shadow * 0.25;
}

float t3d_shadow_pcf(texture2D shadow_texture, vec3 coord, float scale) {
    vec2 inv_size = 1.0 / max(vec2(textureSize(shadow_texture, 0)), vec2(1.0));
    return t3d_shadow_pcf_with_inv_size(shadow_texture, coord, scale, inv_size);
}

mat4 t3d_directional_shadow_matrix(T3DNativeDirectionalLightData light, uint cascade) {
    if (cascade == 0u) {
        return light.shadow_matrix1;
    }
    if (cascade == 1u) {
        return light.shadow_matrix2;
    }
    if (cascade == 2u) {
        return light.shadow_matrix3;
    }
    return light.shadow_matrix4;
}

float t3d_directional_shadow(uint index, vec3 view_position, vec3 view_normal) {
    if ((t3d_forward_light_frame.scene_params.z & 6u) != 6u) {
        return 1.0;
    }
    T3DNativeDirectionalLightData light = t3d_directional_lights.data[index];
    if (light.shadow_opacity <= 0.001) {
        return 1.0;
    }
    float depth_z = -view_position.z;
    // P57: beyond the shadow fade end, mix(shadow, 1, 1) is exactly 1.
    // Avoid cascade, matrix, PCF and shadow-atlas work for those fragments.
    if (light.fade_to > light.fade_from && depth_z >= light.fade_to) {
        return 1.0;
    }
    uint cascade = depth_z < light.shadow_split_offsets.x
        ? 0u
        : (depth_z < light.shadow_split_offsets.y ? 1u : (depth_z < light.shadow_split_offsets.z ? 2u : 3u));
    vec3 base_normal_bias = view_normal * (1.0 - max(0.0, dot(light.direction, -view_normal)));
    vec4 v = vec4(view_position, 1.0);
    v.xyz += light.direction * light.shadow_bias[cascade];
    vec3 normal_bias = base_normal_bias * light.shadow_normal_bias[cascade];
    normal_bias -= light.direction * dot(light.direction, normal_bias);
    v.xyz += normal_bias;
    vec4 coord4 = t3d_directional_shadow_matrix(light, cascade) * v;
    if (abs(coord4.w) < 1e-7) {
        return 1.0;
    }
    vec3 coord = coord4.xyz / coord4.w;
    float filter_scale = t3d_forward_light_frame.scene_params.w != 0u ? max(light.soft_shadow_scale, 1.0) : 0.0;
    float shadow = t3d_shadow_pcf(t3d_directional_shadow_atlas, coord, filter_scale);
    if (light.fade_to > light.fade_from && depth_z > light.fade_from) {
        shadow = mix(shadow, 1.0, clamp((depth_z - light.fade_from) / (light.fade_to - light.fade_from), 0.0, 1.0));
    }
    return mix(1.0, shadow, clamp(light.shadow_opacity, 0.0, 1.0));
}

#ifndef T3D_FORWARD_ONE_SUN
mat4 t3d_native_light_shadow_matrix(T3DNativeLightData light) {
    return mat4(light.shadow_column0, light.shadow_column1, light.shadow_column2, light.shadow_column3);
}

float t3d_omni_shadow(T3DNativeLightData light, vec3 view_position, vec3 view_normal) {
    if ((t3d_forward_light_frame.scene_params.z & 5u) != 5u || light.shadow_opacity <= 0.001) {
        return 1.0;
    }
    vec2 texel = 1.0 / max(vec2(textureSize(t3d_shadow_atlas, 0)), vec2(1.0));
    vec4 uv_rect = light.atlas_rect;
    uv_rect.xy += texel;
    uv_rect.zw -= texel * 2.0;
    vec2 flip_offset = light.direction.xy;
    // P59: both position and normal use the same light-space transform.
    mat4 light_shadow_matrix = t3d_native_light_shadow_matrix(light);
    vec3 local_vert = (light_shadow_matrix * vec4(view_position, 1.0)).xyz;
    float shadow_len = length(local_vert);
    if (shadow_len <= 1e-6) {
        return 1.0;
    }
    vec3 shadow_dir = local_vert / shadow_len;
    vec3 local_normal = normalize(mat3(light_shadow_matrix) * view_normal);
    vec3 normal_bias = local_normal * light.shadow_normal_bias * (1.0 - abs(dot(local_normal, shadow_dir)));
    vec3 shadow_sample = normalize(shadow_dir + normal_bias);
    if (shadow_sample.z >= 0.0) {
        uv_rect.xy += flip_offset;
    }
    shadow_sample.z = 1.0 + abs(shadow_sample.z);
    vec2 pos = shadow_sample.xy / shadow_sample.z;
    float depth = 1.0 - (shadow_len - light.shadow_bias) * light.inv_radius;
    pos = pos * 0.5 + 0.5;
    pos = uv_rect.xy + pos * uv_rect.zw;
    float filter_scale = light.soft_shadow_size > 0.0 ? max(light.soft_shadow_scale / max(shadow_sample.z, 0.001), 0.0) : 0.0;
    float shadow = t3d_shadow_pcf_with_inv_size(t3d_shadow_atlas, vec3(pos, depth), filter_scale, texel);
    return mix(1.0, shadow, clamp(light.shadow_opacity, 0.0, 1.0));
}

float t3d_spot_shadow(T3DNativeLightData light, vec3 view_position, vec3 view_normal, vec3 light_direction, float light_length) {
    if ((t3d_forward_light_frame.scene_params.z & 5u) != 5u || light.shadow_opacity <= 0.001) {
        return 1.0;
    }
    vec3 normal_bias = view_normal * light_length * light.shadow_normal_bias * (1.0 - abs(dot(view_normal, light_direction)));
    vec4 splane = t3d_native_light_shadow_matrix(light) * vec4(view_position + normal_bias, 1.0);
    splane.z += light.shadow_bias;
    if (abs(splane.w) < 1e-7) {
        return 1.0;
    }
    splane /= splane.w;
    vec3 coord = vec3(splane.xy * light.atlas_rect.zw + light.atlas_rect.xy, splane.z);
    float filter_scale = light.soft_shadow_size > 0.0 ? max(light.soft_shadow_scale, 0.0) : 0.0;
    float shadow = t3d_shadow_pcf(t3d_shadow_atlas, coord, filter_scale);
    return mix(1.0, shadow, clamp(light.shadow_opacity, 0.0, 1.0));
}

float t3d_area_shadow(T3DNativeLightData light, vec3 view_position, vec3 view_normal) {
    if ((t3d_forward_light_frame.scene_params.z & 5u) != 5u || light.shadow_opacity <= 0.001) {
        return 1.0;
    }
    mat4 light_shadow_matrix = t3d_native_light_shadow_matrix(light);
    vec3 local_vert = (light_shadow_matrix * vec4(view_position, 1.0)).xyz;
    float shadow_len = length(local_vert);
    if (shadow_len <= 1e-6) {
        return 1.0;
    }
    vec3 shadow_dir = local_vert / shadow_len;
    vec3 local_normal = normalize(mat3(light_shadow_matrix) * view_normal);
    vec3 normal_bias = local_normal * light.shadow_normal_bias * (1.0 - abs(dot(local_normal, shadow_dir)));
    vec3 shadow_sample = normalize(shadow_dir + normal_bias);
    shadow_sample.z = 1.0 + abs(shadow_sample.z);
    vec2 pos = shadow_sample.xy / shadow_sample.z;
    vec2 texel = 1.0 / max(vec2(textureSize(t3d_shadow_atlas, 0)), vec2(1.0));
    vec4 uv_rect = light.atlas_rect;
    uv_rect.xy += texel;
    uv_rect.zw -= texel * 2.0;
    pos = uv_rect.xy + (pos * 0.5 + 0.5) * uv_rect.zw;
    float depth = 1.0 - (shadow_len - light.shadow_bias) * light.cone_attenuation;
    float filter_scale = light.soft_shadow_size > 0.0 ? max(light.soft_shadow_scale / max(shadow_sample.z, 0.001), 0.0) : 0.0;
    float shadow = t3d_shadow_pcf_with_inv_size(t3d_shadow_atlas, vec3(pos, depth), filter_scale, texel);
    return mix(1.0, shadow, clamp(light.shadow_opacity, 0.0, 1.0));
}

#endif

bool t3d_scene_feature(uint feature) {
    return (t3d_forward_light_frame.render_params.w & feature) != 0u;
}

bool t3d_scene_decals_enabled() {
#if T3D_TERRAIN_SHADER_PATH == 0
    if (t3d_scene_integration_class == T3D_SCENE_INTEGRATION_NONE) {
        return false;
    }
#endif
    return t3d_scene_feature(T3D_SCENE_FEATURE_DECALS);
}

bool t3d_scene_reflections_enabled() {
#if T3D_TERRAIN_SHADER_PATH == 0
    if (t3d_scene_integration_class == T3D_SCENE_INTEGRATION_NONE) {
        return false;
    }
#endif
    return t3d_scene_feature(T3D_SCENE_FEATURE_REFLECTIONS);
}

bool t3d_rect_active(vec4 rect) {
    return rect.z > 0.0 && rect.w > 0.0;
}

#if defined(T3D_FORWARD_NATIVE_LIGHTING) && !defined(T3D_FORWARD_DEPTH) && !defined(T3D_FORWARD_ONE_SUN)
// Set at the fragment entry point, before alpha/hole/cull divergence.
vec3 t3d_forward_decal_view_ddx;
vec3 t3d_forward_decal_view_ddy;
#endif

#ifdef T3D_FORWARD_ONE_SUN
void t3d_forward_apply_decals(inout T3DForwardShadingContext context,
    uint surface_mask,
    inout vec3 albedo,
    inout float roughness,
    inout float metallic,
    inout float ao,
    inout vec3 emission) {
}
#else
void t3d_forward_apply_decals(inout T3DForwardShadingContext context,
    uint surface_mask,
    inout vec3 albedo,
    inout float roughness,
    inout float metallic,
    inout float ao,
    inout vec3 emission) {
    if (!t3d_scene_decals_enabled()) {
        return;
    }
#if defined(T3D_FORWARD_COMPACT_CLUSTER_LISTS) && T3D_FORWARD_COMPACT_CLUSTER_LISTS
    T3DBr21Cursor compact_cursor;
    if (!t3d_br21_cursor_begin(context.cluster_address, T3D_CLUSTER_TYPE_DECAL, compact_cursor)) return;
#else
    uint type_offset, item_min, item_max, item_from, item_to;
    if (!t3d_cluster_range(context.cluster_address, T3D_CLUSTER_TYPE_DECAL, type_offset, item_min, item_max, item_from, item_to)) {
        return;
    }
#endif
    vec3 vertex_ddx = t3d_forward_decal_view_ddx;
    vec3 vertex_ddy = t3d_forward_decal_view_ddy;
#if defined(T3D_FORWARD_COMPACT_CLUSTER_LISTS) && T3D_FORWARD_COMPACT_CLUSTER_LISTS
    uint decal_index;
    while (t3d_br21_cursor_next(compact_cursor, decal_index)) {
#else
    for (uint word = item_from; word < item_to; ++word) {
        uint cluster_mask = t3d_cluster_buffer.data[type_offset + word] & t3d_cluster_range_mask(word, item_min, item_max);
        while (cluster_mask != 0u) {
            uint bit = uint(findMSB(cluster_mask));
            cluster_mask &= ~(1u << bit);
            uint decal_index = word * 32u + bit;
#endif
            T3DNativeDecalData decal = t3d_decals.data[decal_index];
            if ((decal.mask & surface_mask) == 0u) {
                continue;
            }
            // P38: ORM/normal decals require an albedo mask in this path.
            // If neither an albedo contribution nor emission is possible,
            // there is nothing to transform or sample.
            bool albedo_active = t3d_rect_active(decal.albedo_rect) && decal.modulate.a != 0.0;
            // P60: emission with an all-zero RGB multiplier cannot affect output.
            bool emission_active = decal.emission_energy != 0.0 && t3d_rect_active(decal.emission_rect)
                && !all(equal(decal.modulate.rgb, vec3(0.0)));
            if (!albedo_active && !emission_active) {
                continue;
            }
            vec3 uv_local = (decal.xform * vec4(context.view_position, 1.0)).xyz;
            if (any(lessThan(uv_local, vec3(0.0, -1.0, 0.0))) || any(greaterThan(uv_local, vec3(1.0)))) {
                continue;
            }
            float fade = pow(max(1.0 - abs(uv_local.y), 0.0), uv_local.y > 0.0 ? decal.upper_fade : decal.lower_fade);
            if (decal.normal_fade > 0.0) {
                fade *= smoothstep(decal.normal_fade, 1.0, dot(context.view_normal, decal.normal) * 0.5 + 0.5);
            }
            // P06: a zero-fade decal contributes to no output channel.  The
            // equality test is deliberately exact: preserve all penumbra and
            // near-zero blends, including editor-authored values.
            if (fade == 0.0) {
                continue;
            }
            vec2 ddx = (decal.xform * vec4(vertex_ddx, 0.0)).xz;
            vec2 ddy = (decal.xform * vec4(vertex_ddy, 0.0)).xz;
            // P60: an emission-only decal needs neither the albedo sample nor
            // the normal/ORM atlas lookups which depend on its alpha mask.
            if (albedo_active) {
                vec2 uv = uv_local.xz * decal.albedo_rect.zw + decal.albedo_rect.xy;
                vec4 decal_albedo =
                    textureGrad(
                        sampler2D(t3d_decal_atlas_srgb, t3d_scene_sampler), uv, ddx * decal.albedo_rect.zw, ddy * decal.albedo_rect.zw)
                    * decal.modulate;
                decal_albedo.a *= fade;
                albedo = mix(albedo, decal_albedo.rgb, decal_albedo.a * decal.albedo_mix);
                if (decal_albedo.a != 0.0 && t3d_rect_active(decal.normal_rect)) {
                    vec2 normal_uv = uv_local.xz * decal.normal_rect.zw + decal.normal_rect.xy;
                    vec3 decal_normal = textureGrad(
                        sampler2D(t3d_decal_atlas, t3d_scene_sampler), normal_uv, ddx * decal.normal_rect.zw, ddy * decal.normal_rect.zw)
                                            .xyz;
                    decal_normal.xy = decal_normal.xy * vec2(2.0, -2.0) - vec2(1.0, -1.0);
                    decal_normal.z = sqrt(max(0.0, 1.0 - dot(decal_normal.xy, decal_normal.xy)));
                    decal_normal = (decal.normal_xform * decal_normal.xzy).xyz;
                    context.view_normal = normalize(mix(context.view_normal, decal_normal, decal_albedo.a));
                }
                if (decal_albedo.a != 0.0 && t3d_rect_active(decal.orm_rect)) {
                    vec2 orm_uv = uv_local.xz * decal.orm_rect.zw + decal.orm_rect.xy;
                    vec3 decal_orm =
                        textureGrad(sampler2D(t3d_decal_atlas, t3d_scene_sampler), orm_uv, ddx * decal.orm_rect.zw, ddy * decal.orm_rect.zw)
                            .xyz;
                    ao = mix(ao, decal_orm.r, decal_albedo.a);
                    roughness = mix(roughness, decal_orm.g, decal_albedo.a);
                    metallic = mix(metallic, decal_orm.b, decal_albedo.a);
                }
            }
            if (emission_active) {
                vec2 emission_uv = uv_local.xz * decal.emission_rect.zw + decal.emission_rect.xy;
                emission += textureGrad(sampler2D(t3d_decal_atlas_srgb, t3d_scene_sampler),
                                emission_uv,
                                ddx * decal.emission_rect.zw,
                                ddy * decal.emission_rect.zw)
                                .rgb
                    * decal.modulate.rgb * decal.emission_energy * fade;
            }
#if defined(T3D_FORWARD_COMPACT_CLUSTER_LISTS) && T3D_FORWARD_COMPACT_CLUSTER_LISTS
    }
#else
        }
    }
#endif
}

#endif

vec2 t3d_oct_wrap(vec2 v) {
    vec2 sign_value = mix(vec2(-1.0), vec2(1.0), greaterThanEqual(v, vec2(0.0)));
    return (1.0 - abs(v.yx)) * sign_value;
}

vec2 t3d_vec3_to_oct(vec3 n) {
    n /= max(abs(n.x) + abs(n.y) + abs(n.z), 1e-8);
    n.xy = n.z >= 0.0 ? n.xy : t3d_oct_wrap(n.xy);
    return n.xy * 0.5 + 0.5;
}

vec2 t3d_vec3_to_oct_with_border(vec3 n) {
    // Matches RenderSceneDataRD::reflection_atlas_border_size: x is the
    // per-probe octahedral padding, y is 1 - 2*x.
    float padding = max(t3d_forward_light_frame.depth_params.w, 0.0);
    return t3d_vec3_to_oct(n) * max(1.0 - padding * 2.0, 0.0) + padding;
}

#ifdef T3D_FORWARD_ONE_SUN
vec3 t3d_forward_reflection(T3DForwardShadingContext context, float roughness, float metallic, vec3 albedo, uint surface_mask) {
    return vec3(0.0);
}
#else
vec3 t3d_forward_reflection(T3DForwardShadingContext context, float roughness, float metallic, vec3 albedo, uint surface_mask) {
    if (!t3d_scene_reflections_enabled()) {
        return vec3(0.0);
    }
#if defined(T3D_FORWARD_COMPACT_CLUSTER_LISTS) && T3D_FORWARD_COMPACT_CLUSTER_LISTS
    T3DBr21Cursor compact_cursor;
    if (!t3d_br21_cursor_begin(context.cluster_address, T3D_CLUSTER_TYPE_REFLECTION, compact_cursor)) return vec3(0.0);
#else
    uint type_offset, item_min, item_max, item_from, item_to;
    if (!t3d_cluster_range(context.cluster_address, T3D_CLUSTER_TYPE_REFLECTION, type_offset, item_min, item_max, item_from, item_to)) {
        return vec3(0.0);
    }
#endif
    vec3 reflected_view = reflect(-context.view_direction, context.view_normal);
    float roughness_lod = sqrt(clamp(roughness, 0.0, 1.0)) * 5.0;
    vec3 accumulated = vec3(0.0);
    float accumulated_weight = 0.0;
#if defined(T3D_FORWARD_COMPACT_CLUSTER_LISTS) && T3D_FORWARD_COMPACT_CLUSTER_LISTS
    uint probe_index;
    while (accumulated_weight < 0.999 && t3d_br21_cursor_next(compact_cursor, probe_index)) {
#else
    for (uint word = item_from; word < item_to && accumulated_weight < 0.999; ++word) {
        uint cluster_mask = t3d_cluster_buffer.data[type_offset + word] & t3d_cluster_range_mask(word, item_min, item_max);
        while (cluster_mask != 0u && accumulated_weight < 0.999) {
            uint bit = uint(findMSB(cluster_mask));
            cluster_mask &= ~(1u << bit);
            uint probe_index = word * 32u + bit;
#endif
            T3DNativeReflectionData probe = t3d_reflections.data[probe_index];
            if ((probe.mask & surface_mask) == 0u || probe.intensity <= 0.0) {
                continue;
            }
            vec3 local_pos = (probe.local_matrix * vec4(context.view_position, 1.0)).xyz;
            if (any(greaterThan(abs(local_pos), probe.box_extents))) {
                continue;
            }
            float blend = 1.0;
            if (probe.blend_distance > 0.0) {
                vec3 axis_distance = min(vec3(probe.blend_distance), probe.box_extents);
                vec3 blend_axes = (abs(local_pos) - probe.box_extents + axis_distance) / max(axis_distance, vec3(1e-6));
                blend_axes = clamp(vec3(1.0) - blend_axes, vec3(0.0), vec3(1.0));
                float blend_product = blend_axes.x * blend_axes.y * blend_axes.z;
                blend = blend_product * blend_product;
            }
            float weight = max(0.0, blend - accumulated_weight);
            if (weight <= 0.0) {
                continue;
            }
            // P51: zero exposure contributes no radiance, but this probe
            // still consumes its original blending weight and occludes later
            // probes. Keep that weight publication outside the sample gate.
            if (probe.exposure_normalization != 0.0) {
                vec3 local_ref = (probe.local_matrix * vec4(reflected_view, 0.0)).xyz;
                if (probe.box_project != 0u) {
                    vec3 nrdir = normalize(local_ref);
                    vec3 safe_dir = vec3(abs(nrdir.x) < 1e-6 ? (nrdir.x < 0.0 ? -1e-6 : 1e-6) : nrdir.x,
                        abs(nrdir.y) < 1e-6 ? (nrdir.y < 0.0 ? -1e-6 : 1e-6) : nrdir.y,
                        abs(nrdir.z) < 1e-6 ? (nrdir.z < 0.0 ? -1e-6 : 1e-6) : nrdir.z);
                    vec3 rbmax = (probe.box_extents - local_pos) / safe_dir;
                    vec3 rbmin = (-probe.box_extents - local_pos) / safe_dir;
                    vec3 rbminmax = mix(rbmin, rbmax, greaterThan(safe_dir, vec3(0.0)));
                    float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
                    local_ref = local_pos + safe_dir * fa - probe.box_offset;
                }
                vec2 reflection_uv = t3d_vec3_to_oct_with_border(local_ref);
                vec3 reflected =
                    textureLod(sampler2DArray(t3d_reflection_atlas, t3d_scene_sampler), vec3(reflection_uv, probe.index), roughness_lod).rgb;
                reflected *= probe.exposure_normalization * probe.intensity;
                accumulated += reflected * weight;
            }
            accumulated_weight += weight;
#if defined(T3D_FORWARD_COMPACT_CLUSTER_LISTS) && T3D_FORWARD_COMPACT_CLUSTER_LISTS
    }
#else
        }
    }
#endif
    // P39: an empty / rejected probe list has zero contribution. The
    // Fresnel evaluation would multiply an exactly zero accumulator.
    if (accumulated_weight == 0.0) return vec3(0.0);
    vec3 f0 = mix(vec3(0.04), albedo, clamp(metallic, 0.0, 1.0));
    float ndotv = clamp(dot(context.view_normal, context.view_direction), 0.0, 1.0);
    float fresnel_base = 1.0 - ndotv;
    float fresnel_base2 = fresnel_base * fresnel_base;
    float fresnel_factor = fresnel_base2 * fresnel_base2 * fresnel_base;
    vec3 fresnel = f0 + (vec3(1.0) - f0) * fresnel_factor;
    return accumulated * fresnel;
}

#endif

vec3 t3d_forward_radiance_sample(vec3 direction, float roughness) {
    vec3 radiance_direction = t3d_forward_light_frame.radiance_inverse_xform * direction;
    vec2 radiance_uv = t3d_vec3_to_oct_with_border(radiance_direction);
#ifdef T3D_FORWARD_RADIANCE_ARRAY
    float roughness_layer;
    float roughness_blend = modf(sqrt(clamp(roughness, 0.0, 1.0)) * 5.0, roughness_layer);
    vec3 sample_a = textureLod(sampler2DArray(t3d_radiance_octmap, t3d_scene_sampler), vec3(radiance_uv, roughness_layer), 0.0).rgb;
    if (roughness_blend == 0.0 || roughness_layer >= 5.0) return sample_a;
    vec3 sample_b =
        textureLod(sampler2DArray(t3d_radiance_octmap, t3d_scene_sampler), vec3(radiance_uv, min(roughness_layer + 1.0, 5.0)), 0.0).rgb;
    return mix(sample_a, sample_b, roughness_blend);
#else
    return textureLod(sampler2D(t3d_radiance_octmap, t3d_scene_sampler), radiance_uv, sqrt(clamp(roughness, 0.0, 1.0)) * 5.0).rgb;
#endif
}

void t3d_forward_environment_lighting(vec3 albedo,
    T3DForwardShadingContext context,
    float roughness,
    float metallic,
    float ao,
    float specular_amount,
    out vec3 ambient_diffuse,
    out vec3 environment_specular) {
    ambient_diffuse = vec3(0.0);
    environment_specular = vec3(0.0);
    // P50: the ambient result is suppressed by either full metallicity or
    // zero AO. Do not fetch an environment cubemap for those fragments.
    if (ao != 0.0 && clamp(metallic, 0.0, 1.0) < 1.0) {
        vec3 ambient_light = vec3(0.0);
        if (t3d_scene_feature(T3D_SCENE_FEATURE_AMBIENT_LIGHT)) {
            ambient_light = t3d_forward_light_frame.ambient_light_color_energy.rgb;
            if (t3d_scene_feature(T3D_SCENE_FEATURE_AMBIENT_CUBEMAP)) {
                float sky_mix = clamp(t3d_forward_light_frame.environment_params0.x, 0.0, 1.0);
                if (sky_mix > 0.0) {
                    vec3 cubemap_ambient = vec3(0.0);
                    // P40: zero sky weight and zero radiance energy require
                    // no environment texture fetch. Retain the original mix.
                    if (t3d_forward_light_frame.environment_params0.z != 0.0
                        && t3d_forward_light_frame.ambient_light_color_energy.a != 0.0) {
                        cubemap_ambient = t3d_forward_radiance_sample(context.view_normal, 1.0)
                            * t3d_forward_light_frame.environment_params0.z
                            * t3d_forward_light_frame.ambient_light_color_energy.a;
                    }
                    ambient_light = mix(ambient_light, cubemap_ambient, sky_mix);
                }
            }
        }
        ambient_diffuse = ambient_light * albedo * (1.0 - clamp(metallic, 0.0, 1.0)) * ao;
    }

    if (t3d_scene_feature(T3D_SCENE_FEATURE_REFLECTION_CUBEMAP) && specular_amount > 0.0) {
        vec3 reflected = reflect(-context.view_direction, context.view_normal);
        reflected = normalize(mix(reflected, context.view_normal, roughness * roughness));
        float horizon = min(1.0 + dot(reflected, context.view_normal), 1.0);
        // P40: all terms below multiply these exact factors. Bypass the
        // radiance lookup/Fresnel when the environment response is zero.
        if (horizon == 0.0 || ao <= 0.0 || t3d_forward_light_frame.environment_params0.z == 0.0
            || t3d_forward_light_frame.ambient_light_color_energy.a == 0.0) return;
        vec3 f0 = mix(vec3(0.04 * specular_amount), albedo, clamp(metallic, 0.0, 1.0));
        float ndotv = clamp(dot(context.view_normal, context.view_direction), 0.0, 1.0);
        float fresnel_base = 1.0 - ndotv;
        float fresnel_base2 = fresnel_base * fresnel_base;
        float fresnel_factor = fresnel_base2 * fresnel_base2 * fresnel_base;
        vec3 fresnel = f0 + (vec3(1.0) - f0) * fresnel_factor;
        environment_specular = t3d_forward_radiance_sample(reflected, roughness) * t3d_forward_light_frame.environment_params0.z
            * t3d_forward_light_frame.ambient_light_color_energy.a * horizon * horizon * fresnel * clamp(ao, 0.0, 1.0);
    }
}

// Direct PBR uses Cook-Torrance / GGX (Trowbridge-Reitz NDF, Smith-Schlick
// masking, and Schlick Fresnel). Blinn-Phong remains a distinct cheap path.
struct T3DBrdfContext {
    vec3 albedo;
    vec3 normal;
    vec3 view_direction;
    vec3 f0;
    float gloss;
    float spec_power;
    float model2_diffuse_scale;
    float alpha_squared;
    float geometry_k;
    float metallic;
};

T3DBrdfContext t3d_prepare_brdf(vec3 albedo, vec3 normal, vec3 view_direction, float roughness, float metallic, uint lighting_model) {
    T3DBrdfContext brdf;
    brdf.albedo = albedo;
    brdf.normal = normal;
    brdf.view_direction = view_direction;
    brdf.f0 = vec3(0.0);
    brdf.gloss = 0.0;
    brdf.spec_power = 4.0;
    brdf.model2_diffuse_scale = 1.0;
    brdf.alpha_squared = 1.0;
    brdf.geometry_k = 0.5;
    brdf.metallic = clamp(metallic, 0.0, 1.0);
    if (lighting_model == 1u) {
        return brdf;
    }
    brdf.f0 = mix(vec3(0.04), albedo, brdf.metallic);
    if (lighting_model == 2u) {
        brdf.gloss = max(1.0 - roughness, 0.0);
        brdf.spec_power = mix(4.0, 128.0, brdf.gloss * brdf.gloss);
        brdf.model2_diffuse_scale = 1.0 - brdf.metallic * 0.6;
        return brdf;
    }
    // alpha = perceptual_roughness^2; limit singular highlights at roughness 0.
    float r = max(clamp(roughness, 0.0, 1.0), 0.045);
    float alpha = r * r;
    brdf.alpha_squared = alpha * alpha;
    float r_plus_one = r + 1.0;
    brdf.geometry_k = r_plus_one * r_plus_one * 0.125;
    return brdf;
}

// BR03: use the existing pipeline ID 25 to select a single BRDF response
// kernel in the canonical terrain variant. Legacy shader paths keep the
// runtime model selection, and no new pipeline specialization IDs are used.
#ifndef T3D_FORWARD_SPECIALIZED_BRDF
#define T3D_FORWARD_SPECIALIZED_BRDF 0
#endif

void t3d_light_response_lambert(T3DBrdfContext brdf, vec3 radiance,
    float ndotl, float attenuation, inout vec3 diffuse_light) {
    diffuse_light += brdf.albedo * radiance * ((ndotl * attenuation) / T3D_PI);
}

void t3d_light_response_blinn(T3DBrdfContext brdf, vec3 light_direction,
    vec3 radiance, float ndotl, float attenuation, float specular_amount,
    inout vec3 diffuse_light, inout vec3 specular_light) {
    diffuse_light += brdf.albedo * (ndotl / T3D_PI) * brdf.model2_diffuse_scale * radiance * attenuation;
    if (brdf.gloss > 0.0 && specular_amount > 0.0) {
        vec3 half_sum = light_direction + brdf.view_direction;
        vec3 half_direction = half_sum * inversesqrt(max(dot(half_sum, half_sum), 1e-8));
        float specular_term = pow(max(dot(brdf.normal, half_direction), 0.0), brdf.spec_power)
            * brdf.gloss * specular_amount;
        specular_light += brdf.f0 * specular_term * radiance * attenuation;
    }
}

void t3d_light_response_ggx(T3DBrdfContext brdf, vec3 light_direction,
    vec3 radiance, float ndotl, float attenuation, float specular_amount,
    inout vec3 diffuse_light, inout vec3 specular_light) {
    // P54: evaluate view-facing eligibility before the half-vector. GGX
    // diffuse still needs half-vector Fresnel for contributing fragments.
    float ndotv = max(dot(brdf.normal, brdf.view_direction), 0.0);
    if (ndotv <= 0.0) {
        return;
    }
    vec3 half_sum = light_direction + brdf.view_direction;
    vec3 half_direction = half_sum * inversesqrt(max(dot(half_sum, half_sum), 1e-8));
    float vdoth = max(dot(brdf.view_direction, half_direction), 0.0);
    float one_minus_vh = 1.0 - vdoth;
    float one_minus_vh2 = one_minus_vh * one_minus_vh;
    float schlick = one_minus_vh2 * one_minus_vh2 * one_minus_vh;
    vec3 fresnel = brdf.f0 + (vec3(1.0) - brdf.f0) * schlick;
    vec3 kd = (vec3(1.0) - fresnel) * (1.0 - brdf.metallic);
    vec3 light_energy = radiance * (ndotl * attenuation);
    diffuse_light += kd * brdf.albedo * (1.0 / T3D_PI) * light_energy;
    // Output-flag and per-light specular can be zero; skip the GGX D/G work.
    if (specular_amount > 0.0) {
        float ndoth = max(dot(brdf.normal, half_direction), 0.0);
        float d_denom = ndoth * ndoth * (brdf.alpha_squared - 1.0) + 1.0;
        float distribution = brdf.alpha_squared / max(T3D_PI * d_denom * d_denom, 1e-7);
        float gv = ndotv * (1.0 - brdf.geometry_k) + brdf.geometry_k;
        float gl = ndotl * (1.0 - brdf.geometry_k) + brdf.geometry_k;
        float visibility = 0.25 / max(gv * gl, 1e-5);
        specular_light += fresnel * (distribution * visibility * specular_amount) * light_energy;
    }
}

#if T3D_FORWARD_SPECIALIZED_BRDF
void t3d_light_response(T3DBrdfContext brdf,
    uint lighting_model,
    vec3 light_direction,
    vec3 radiance,
    float attenuation,
    float specular_amount,
    inout vec3 diffuse_light,
    inout vec3 specular_light) {
    float ndotl = max(dot(brdf.normal, light_direction), 0.0);
    if (ndotl <= 0.0 || attenuation <= 0.0) return;
#if T3D_TERRAIN_SHADER_PATH == 0
    // ID 25 is already published by the clipmap pipeline for every canonical
    // color draw. Specialization folds this dispatch into one BRDF body.
    if (t3d_lighting_model_class != T3D_LIGHTING_MODEL_RUNTIME) {
        lighting_model = t3d_lighting_model_class;
    }
#endif
    if (lighting_model == 1u) {
        t3d_light_response_lambert(brdf, radiance, ndotl, attenuation, diffuse_light);
    } else if (lighting_model == 2u) {
        t3d_light_response_blinn(brdf, light_direction, radiance, ndotl,
            attenuation, specular_amount, diffuse_light, specular_light);
    } else {
        t3d_light_response_ggx(brdf, light_direction, radiance, ndotl,
            attenuation, specular_amount, diffuse_light, specular_light);
    }
}
#else
void t3d_light_response(T3DBrdfContext brdf,
    uint lighting_model,
    vec3 light_direction,
    vec3 radiance,
    float attenuation,
    float specular_amount,
    inout vec3 diffuse_light,
    inout vec3 specular_light) {
    float ndotl = max(dot(brdf.normal, light_direction), 0.0);
    if (ndotl <= 0.0 || attenuation <= 0.0) {
        return;
    }
    if (lighting_model == 1u) {
        diffuse_light += brdf.albedo * radiance * ((ndotl * attenuation) / T3D_PI);
        return;
    }
    if (lighting_model == 2u) {
        diffuse_light += brdf.albedo * (ndotl / T3D_PI) * brdf.model2_diffuse_scale * radiance * attenuation;
        // P41: Blinn highlights vanish when either gloss or per-light
        // specular is zero. Avoid half-vector normalization and pow.
        if (brdf.gloss > 0.0 && specular_amount > 0.0) {
            vec3 half_sum = light_direction + brdf.view_direction;
            vec3 half_direction = half_sum * inversesqrt(max(dot(half_sum, half_sum), 1e-8));
            float specular_term = pow(max(dot(brdf.normal, half_direction), 0.0), brdf.spec_power)
                * brdf.gloss * specular_amount;
            specular_light += brdf.f0 * specular_term * radiance * attenuation;
        }
        return;
    }

    // P54: evaluate view-facing eligibility before the half-vector. GGX
    // diffuse still needs half-vector Fresnel for contributing fragments.
    float ndotv = max(dot(brdf.normal, brdf.view_direction), 0.0);
    if (ndotv <= 0.0) {
        return;
    }
    vec3 half_sum = light_direction + brdf.view_direction;
    vec3 half_direction = half_sum * inversesqrt(max(dot(half_sum, half_sum), 1e-8));
    float vdoth = max(dot(brdf.view_direction, half_direction), 0.0);
    float one_minus_vh = 1.0 - vdoth;
    float one_minus_vh2 = one_minus_vh * one_minus_vh;
    float schlick = one_minus_vh2 * one_minus_vh2 * one_minus_vh;
    vec3 fresnel = brdf.f0 + (vec3(1.0) - brdf.f0) * schlick;
    vec3 kd = (vec3(1.0) - fresnel) * (1.0 - brdf.metallic);
    vec3 light_energy = radiance * (ndotl * attenuation);
    diffuse_light += kd * brdf.albedo * (1.0 / T3D_PI) * light_energy;
    // Output-flag and per-light specular can be zero; skip the GGX D/G work.
    if (specular_amount > 0.0) {
        float ndoth = max(dot(brdf.normal, half_direction), 0.0);
        float d_denom = ndoth * ndoth * (brdf.alpha_squared - 1.0) + 1.0;
        float distribution = brdf.alpha_squared / max(T3D_PI * d_denom * d_denom, 1e-7);
        float gv = ndotv * (1.0 - brdf.geometry_k) + brdf.geometry_k;
        float gl = ndotl * (1.0 - brdf.geometry_k) + brdf.geometry_k;
        float visibility = 0.25 / max(gv * gl, 1e-5);
        specular_light += fresnel * (distribution * visibility * specular_amount) * light_energy;
    }
}

#endif

void t3d_forward_direct_lighting(vec3 albedo,
    T3DForwardShadingContext context,
    float roughness,
    float metallic,
    float material_specular_scale,
    uint surface_mask,
    uint lighting_model,
#ifdef T3D_FORWARD_RUNTIME_SHADOW_TOGGLE
    bool receive_shadows,
#endif
    uint directional_shadowmask_mode,
    float directional_shadow_visibility,
    out vec3 diffuse_light,
    out vec3 specular_light) {
    diffuse_light = vec3(0.0);
    specular_light = vec3(0.0);
    if (lighting_model == 0u) {
        return;
    }
    T3DBrdfContext brdf = t3d_prepare_brdf(albedo, context.view_normal, context.view_direction, roughness, metallic, lighting_model);
    // P42: GGX t3d_light_response rejects every light at nonpositive N.V.
    // Keep Blinn and Lambert semantics, which do not use that rejection.
    if (lighting_model != 1u && lighting_model != 2u
        && dot(brdf.normal, brdf.view_direction) <= 0.0) return;

#ifdef T3D_FORWARD_ONE_SUN
    // WG-G: direct common path. The source family is already capped to one
    // directional light, so avoid a generic loop and the i==0 shadowmask test.
    if (t3d_forward_light_frame.scene_params.x != 0u) {
        T3DNativeDirectionalLightData light = t3d_directional_lights.data[0];
        if ((light.mask & surface_mask) != 0u && light.energy != 0.0
            && !all(equal(light.color, vec3(0.0)))) {
            vec3 light_direction = normalize(light.direction);
            if (dot(brdf.normal, light_direction) > 0.0) {
                // Baked mode 1 replaces the shadow result, and an unlit
                // normal cannot contribute to any supported BRDF.
                float shadow = 1.0;
                if (directional_shadowmask_mode != 1u) {
#ifdef T3D_FORWARD_RUNTIME_SHADOW_TOGGLE
                    if (receive_shadows)
#endif
                        shadow = t3d_directional_shadow(0u, context.view_position, context.view_normal);
                }
                if (directional_shadowmask_mode != 0u) {
                    float baked_visibility = clamp(directional_shadow_visibility, 0.0, 1.0);
                    shadow = directional_shadowmask_mode == 1u ? baked_visibility : shadow * baked_visibility;
                }
                t3d_light_response(brdf,
                    lighting_model,
                    light_direction,
                    light.color * light.energy,
                    shadow,
                    light.specular * material_specular_scale,
                    diffuse_light,
                    specular_light);
            }
        }
    }
#else
    uint directional_count = min(t3d_forward_light_frame.scene_params.x, 8u);
    for (uint i = 0u; i < directional_count; ++i) {
        T3DNativeDirectionalLightData light = t3d_directional_lights.data[i];
        // P43: exact zero-radiance directional lights cannot contribute.
        if ((light.mask & surface_mask) == 0u || light.energy == 0.0
            || all(equal(light.color, vec3(0.0)))) {
            continue;
        }
        vec3 light_direction = normalize(light.direction);
        if (dot(brdf.normal, light_direction) <= 0.0) {
            continue;
        }
        bool baked_only = i == 0u && directional_shadowmask_mode == 1u;
        float shadow = 1.0;
        if (!baked_only) {
#ifdef T3D_FORWARD_RUNTIME_SHADOW_TOGGLE
            if (receive_shadows)
#endif
                shadow = t3d_directional_shadow(i, context.view_position, context.view_normal);
        }
        if (i == 0u && directional_shadowmask_mode != 0u) {
            float baked_visibility = clamp(directional_shadow_visibility, 0.0, 1.0);
            shadow = baked_only ? baked_visibility : shadow * baked_visibility;
        }
        t3d_light_response(brdf,
            lighting_model,
            light_direction,
            light.color * light.energy,
            shadow,
            light.specular * material_specular_scale,
            diffuse_light,
            specular_light);
    }

    for (uint light_type = 0u; light_type < 3u; ++light_type) {
#if defined(T3D_FORWARD_COMPACT_CLUSTER_LISTS) && T3D_FORWARD_COMPACT_CLUSTER_LISTS
        T3DBr21Cursor compact_cursor;
        if (!t3d_br21_cursor_begin(context.cluster_address, light_type, compact_cursor)) continue;
        uint light_index;
        while (t3d_br21_cursor_next(compact_cursor, light_index)) {
#else
        uint type_offset, item_min, item_max, item_from, item_to;
        if (!t3d_cluster_range(context.cluster_address, light_type, type_offset, item_min, item_max, item_from, item_to)) {
            continue;
        }
        for (uint word = item_from; word < item_to; ++word) {
            uint mask = t3d_cluster_buffer.data[type_offset + word] & t3d_cluster_range_mask(word, item_min, item_max);
            while (mask != 0u) {
                uint bit = uint(findMSB(mask));
                mask &= ~(1u << bit);
                uint light_index = word * 32u + bit;
#endif
                T3DNativeLightData light = light_type == 0u
                    ? t3d_omni_lights.data[light_index]
                    : (light_type == 1u ? t3d_spot_lights.data[light_index] : t3d_area_lights.data[light_index]);
                // P43: empty radiance avoids attenuation, light-shape
                // transforms and every local shadow path.
                if ((light.mask & surface_mask) == 0u
                    || all(equal(light.color, vec3(0.0)))) {
                    continue;
                }
                vec3 light_direction;
                float distance_to_light;
                float attenuation;
                float shadow = 1.0;
                if (light_type == 0u || light_type == 1u) {
                    vec3 to_light = light.position - context.view_position;
                    distance_to_light = length(to_light);
                    if (distance_to_light <= 1e-6) {
                        continue;
                    }
                    light_direction = to_light / distance_to_light;
                    // P58: a noncontributing surface does not need distance
                    // attenuation, spot-cone pow, or any local shadow setup.
                    if (dot(brdf.normal, light_direction) <= 0.0) {
                        continue;
                    }
                    attenuation = t3d_native_attenuation(distance_to_light, light.inv_radius, light.attenuation);
                    if (attenuation <= 0.0) {
                        continue;
                    }
                }
                if (light_type == 0u) {
                    // P06: preserve all nonzero contributions; zero falloff
                    // produces exactly zero diffuse and specular light.
                    if (attenuation <= 0.0 || dot(brdf.normal, light_direction) <= 0.0) {
                        continue;
                    }
#ifdef T3D_FORWARD_RUNTIME_SHADOW_TOGGLE
                    if (receive_shadows) {
                        shadow = t3d_omni_shadow(light, context.view_position, context.view_normal);
                    }
#else
                    shadow = t3d_omni_shadow(light, context.view_position, context.view_normal);
#endif
                } else if (light_type == 1u) {
                    float cone_angle = light.cone_angle;
                    float scos = max(dot(-light_direction, light.direction), cone_angle);
                    float spot_rim = max(1e-4, (1.0 - scos) / max(1.0 - cone_angle, 1e-4));
                    attenuation *= 1.0 - pow(spot_rim, light.cone_attenuation);
                    if (attenuation <= 0.0 || dot(brdf.normal, light_direction) <= 0.0) {
                        continue;
                    }
#ifdef T3D_FORWARD_RUNTIME_SHADOW_TOGGLE
                    if (receive_shadows) {
                        shadow = t3d_spot_shadow(light, context.view_position, context.view_normal, light_direction, distance_to_light);
                    }
#else
                    shadow = t3d_spot_shadow(light, context.view_position, context.view_normal, light_direction, distance_to_light);
#endif
                } else {
                    // Godot area lights are one-sided rectangles. Use the same native width/height vectors and
                    // closest-point distance as Forward+ while keeping Terrain3D's simplified direct BRDF.
                    if (dot(light.direction, context.view_position - light.position) <= 0.0) {
                        continue;
                    }
                    float width_length = length(light.area_width);
                    float height_length = length(light.area_height);
                    if (width_length <= 1e-6 || height_length <= 1e-6) {
                        continue;
                    }
                    vec3 width_direction = light.area_width / width_length;
                    vec3 height_direction = light.area_height / height_length;
                    vec3 from_center = context.view_position - light.position;
                    float local_x = clamp(dot(from_center, width_direction), -0.5 * width_length, 0.5 * width_length);
                    float local_y = clamp(dot(from_center, height_direction), -0.5 * height_length, 0.5 * height_length);
                    vec3 closest_point = light.position + width_direction * local_x + height_direction * local_y;
                    vec3 to_light = closest_point - context.view_position;
                    distance_to_light = length(to_light);
                    if (distance_to_light <= 1e-6) {
                        continue;
                    }
                    light_direction = to_light / distance_to_light;
                    // P58: reject the same zero N.L before attenuation math.
                    if (dot(brdf.normal, light_direction) <= 0.0) {
                        continue;
                    }
                    attenuation = t3d_native_attenuation(distance_to_light, light.inv_radius, light.attenuation);
                    if (attenuation <= 0.0) {
                        continue;
                    }
                    // LTC is intentionally not duplicated; projected rectangle area supplies the far-field energy scale.
                    float area = max(width_length * height_length, 0.0001);
                    attenuation *= clamp(area / max(area, distance_to_light * distance_to_light), 0.0, 1.0);
                    if (attenuation <= 0.0 || dot(brdf.normal, light_direction) <= 0.0) {
                        continue;
                    }
#ifdef T3D_FORWARD_RUNTIME_SHADOW_TOGGLE
                    if (receive_shadows) {
                        shadow = t3d_area_shadow(light, context.view_position, context.view_normal);
                    }
#else
                    shadow = t3d_area_shadow(light, context.view_position, context.view_normal);
#endif
                }
                t3d_light_response(brdf,
                    lighting_model,
                    light_direction,
                    light.color,
                    attenuation * shadow,
                    light.specular_amount * material_specular_scale,
                    diffuse_light,
                    specular_light);
#if defined(T3D_FORWARD_COMPACT_CLUSTER_LISTS) && T3D_FORWARD_COMPACT_CLUSTER_LISTS
        }
#else
            }
        }
#endif
    }
#endif
}

#endif // T3D_FORWARD_NATIVE_LIGHTING && !T3D_FORWARD_DEPTH
#endif // TERRAIN3D_FORWARD_LIGHTING_INC_GLSL
