// Vertex-only FAR sampling uses V1's existing allocation, page-table,
// parent and tail records. No independent far-height residency authority.
#ifndef T3D_WORLD_RASTER_MESH
#if defined(T3D_WORLD_RASTER_EMBEDDED)
#define T3D_FAR_VERTEX_SET 1
#define T3D_FAR_VERTEX_ALLOCATION_BINDING 1
#define T3D_FAR_VERTEX_PAGE_BINDING 2
#define T3D_FAR_VERTEX_TAIL_META_BINDING 7
#define T3D_FAR_VERTEX_MIP_BINDING 12
#define T3D_FAR_VERTEX_HEIGHT_BINDING 18
#define T3D_FAR_VERTEX_TAIL_BINDING 19
#else
#define T3D_FAR_VERTEX_SET 0
#define T3D_FAR_VERTEX_ALLOCATION_BINDING 26
#define T3D_FAR_VERTEX_PAGE_BINDING 27
#define T3D_FAR_VERTEX_TAIL_META_BINDING 32
#define T3D_FAR_VERTEX_MIP_BINDING 37
#define T3D_FAR_VERTEX_HEIGHT_BINDING 44
#define T3D_FAR_VERTEX_TAIL_BINDING 45
#endif
layout(set = T3D_FAR_VERTEX_SET, binding = T3D_FAR_VERTEX_ALLOCATION_BINDING, std430)
    readonly buffer TerrainFarVertexAllocations { T3DVTAllocation t3d_far_vertex_allocations[]; };
layout(set = T3D_FAR_VERTEX_SET, binding = T3D_FAR_VERTEX_PAGE_BINDING, std430)
    readonly buffer TerrainFarVertexPages { T3DVTPageEntry t3d_far_vertex_pages[]; };
layout(set = T3D_FAR_VERTEX_SET, binding = T3D_FAR_VERTEX_TAIL_META_BINDING, std430)
    readonly buffer TerrainFarVertexTails { T3DVTTailMetadata t3d_far_vertex_tails[]; };
layout(set = T3D_FAR_VERTEX_SET, binding = T3D_FAR_VERTEX_MIP_BINDING, std430)
    readonly buffer TerrainFarVertexLayouts { T3DVTMipLayout t3d_far_vertex_layouts[]; };
layout(set = T3D_FAR_VERTEX_SET, binding = T3D_FAR_VERTEX_HEIGHT_BINDING)
    uniform sampler2DArray t3d_far_vertex_height16;
layout(set = T3D_FAR_VERTEX_SET, binding = T3D_FAR_VERTEX_TAIL_BINDING)
    uniform sampler2D t3d_far_vertex_height16_tail;

bool t3d_far_height_v1(vec2 world_texel, out float encoded) {
    ivec2 cell = ivec2(floor(world_texel * T3D_REGION_INV_SIZE_F));
    ivec2 region = cell + ivec2(T3D_REGION_MAP_HALF);
    if (any(lessThan(region, ivec2(0))) || any(greaterThanEqual(region, ivec2(T3D_REGION_MAP_SIZE)))) return false;
    TerrainRegionRecord record = region_map[T3D_CLIPMAP_REGION_BASE + region.y * T3D_REGION_MAP_SIZE + region.x];
    if (record.far_vt_allocation == T3D_VT_INVALID_ALLOCATION ||
        (record.packed_physical_flags & 0x80000000u) == 0u) return false;
    uint id = record.far_vt_allocation + 2u;
    T3DVTAllocation alloc = t3d_far_vertex_allocations[id];
    uint count = min(alloc.packedMipCountFlags & 0xffffu, T3D_VT_MAX_MIPS);
    if (count == 0u || alloc.pageCount == 0u ||
        (record.far_vt_generation != 0u && record.far_vt_generation != alloc.generation)) return false;
    vec2 uv = clamp(fract(world_texel * T3D_REGION_INV_SIZE_F), vec2(0.0), vec2(0.999999));
    T3DVTMipLayout baseLayout = t3d_far_vertex_layouts[id * T3D_VT_MAX_MIPS];
    uvec2 extent = uvec2(baseLayout.packedExtent & 0xffffu, baseLayout.packedExtent >> 16u);
    if (any(equal(extent, uvec2(0))) || baseLayout.baseVirtualPage == T3D_VT_INVALID_PAGE) return false;
    uvec2 pageXY = min(uvec2(floor(uv * vec2(extent))), extent - uvec2(1));
    uint page = baseLayout.baseVirtualPage + pageXY.y * extent.x + pageXY.x;
    uint end = alloc.baseVirtualPage + alloc.pageCount;
    for (uint probe = 0u; probe < T3D_VT_ANCESTOR_PROBE_CAP; ++probe) {
        if (page < alloc.baseVirtualPage || page >= end) break;
        T3DVTPageEntry entry = t3d_far_vertex_pages[page];
        uint flags = entry.packedResolvedMipFlags >> 16u;
        if (entry.generation != alloc.generation || (flags & T3D_VT_PAGE_VALID) == 0u) break;
        if ((flags & T3D_VT_PAGE_RESIDENT) != 0u && entry.physicalSlot != T3D_VT_INVALID_SLOT &&
            t3d_vt_v1_physical_family(entry.physicalSlot) == T3D_VT_PHYSICAL_FORMAT_R16_UNORM) {
            uint mip = min(entry.packedResolvedMipFlags & 0xffffu, count - 1u);
            T3DVTMipLayout mip_layout = t3d_far_vertex_layouts[id * T3D_VT_MAX_MIPS + mip];
            uvec2 span = max(uvec2(mip_layout.packedExtent & 0xffffu, mip_layout.packedExtent >> 16u), uvec2(1));
            vec2 local = fract(uv * vec2(span));
            vec2 tileUV = (vec2(float(T3D_VT_PAGE_GUTTER)) + local * float(T3D_VT_PAGE_INTERIOR))
                / float(T3D_VT_PHYSICAL_TILE);
            encoded = textureLod(t3d_far_vertex_height16,
                vec3(tileUV, float(t3d_vt_v1_physical_slot(entry.physicalSlot))), 0.0).r;
            return true;
        }
        if (entry.parentPage == T3D_VT_INVALID_PAGE) break;
        page = entry.parentPage;
    }
    if (alloc.tailIndex == T3D_VT_INVALID_TAIL) return false;
    T3DVTTailMetadata tail = t3d_far_vertex_tails[alloc.tailIndex];
    if (tail.generation != alloc.generation ||
        (tail.channelMask & (1u << T3D_VT_CHANNEL_HEIGHT16)) == 0u) return false;
    vec2 size2 = vec2(textureSize(t3d_far_vertex_height16_tail, 0));
    uvec2 firstExtent = uvec2(tail.packedExtent & 0xffffu, tail.packedExtent >> 16u);
    uint firstMip = tail.packedMipRange & 0xffffu;
    uint delta = min(count - 1u - min(firstMip, count - 1u), max((tail.packedMipRange >> 16u), 1u) - 1u);
    uint offset = t3d_vt_tail_mip_offset(max(firstExtent.x, 1u), delta);
    vec2 extent2 = vec2(max(firstExtent >> delta, uvec2(1)));
    vec2 pixel = vec2(tail.atlasX + offset, tail.atlasY) + vec2(0.5) + uv * max(extent2 - vec2(1.0), vec2(0.0));
    encoded = textureLod(t3d_far_vertex_height16_tail, pixel / max(size2, vec2(1)), 0.0).r;
    return true;
}
#endif
