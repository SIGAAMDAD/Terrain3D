// Terrain clipmap fragment pipeline interface.
// Stage roots include this explicitly so reusable material evaluation cannot silently add descriptors or stage I/O.


// Shared clipmap/world-raster VT descriptor ABI. The standalone clipmap path
// keeps the historical set-0 bindings; embedded world-raster callers override
// these before including this file so the same fragment implementation can use
// their set-1 VT layout without declaring a second, stale set-0 resource block.
#ifndef T3D_TERRAIN_VT_DESCRIPTOR_SET
#define T3D_TERRAIN_VT_DESCRIPTOR_SET 0
#endif
#ifndef T3D_TERRAIN_VT_ALLOCATION_BINDING
#define T3D_TERRAIN_VT_ALLOCATION_BINDING 26
#endif
#ifndef T3D_TERRAIN_VT_PAGE_TABLE_BINDING
#define T3D_TERRAIN_VT_PAGE_TABLE_BINDING 27
#endif
#ifndef T3D_TERRAIN_VT_ALBEDO_BINDING
#define T3D_TERRAIN_VT_ALBEDO_BINDING 28
#endif
#ifndef T3D_TERRAIN_VT_NORMAL_BINDING
#define T3D_TERRAIN_VT_NORMAL_BINDING 29
#endif
#ifndef T3D_TERRAIN_VT_SURFACE_BINDING
#define T3D_TERRAIN_VT_SURFACE_BINDING 30
#endif
#ifndef T3D_TERRAIN_VT_HEIGHT_BINDING
#define T3D_TERRAIN_VT_HEIGHT_BINDING 31
#endif
#ifndef T3D_TERRAIN_VT_TAIL_METADATA_BINDING
#define T3D_TERRAIN_VT_TAIL_METADATA_BINDING 32
#endif
#ifndef T3D_TERRAIN_VT_ALBEDO_TAIL_BINDING
#define T3D_TERRAIN_VT_ALBEDO_TAIL_BINDING 33
#endif
#ifndef T3D_TERRAIN_VT_NORMAL_TAIL_BINDING
#define T3D_TERRAIN_VT_NORMAL_TAIL_BINDING 34
#endif
#ifndef T3D_TERRAIN_VT_SURFACE_TAIL_BINDING
#define T3D_TERRAIN_VT_SURFACE_TAIL_BINDING 35
#endif
#ifndef T3D_TERRAIN_VT_HEIGHT_TAIL_BINDING
#define T3D_TERRAIN_VT_HEIGHT_TAIL_BINDING 36
#endif
#ifndef T3D_TERRAIN_VT_MIP_LAYOUT_BINDING
#define T3D_TERRAIN_VT_MIP_LAYOUT_BINDING 37
#endif

#ifndef T3D_WORLD_RASTER_MESH
// WG-C SH04 production policy: the shared set-3 feedback ABI remains dormant
// until its frame/reset publication owner is wired. The adapter is still
// compiled by the authoritative feedback fixture lane so activation cannot
// regress silently. Pure depth remains feedback-free by contract.
#define T3D_TERRAIN_FRAGMENT_FEEDBACK_PRODUCTION_DISABLED 1
#define T3D_VT_TERRAIN_FEEDBACK_ALLOCATION(logical_material_id) (materials[int(logical_material_id)].micro_vt_allocation)

#if defined(T3D_VT_FRAGMENT_FEEDBACK) && (!defined(T3D_FORWARD_DEPTH) || defined(T3D_FORWARD_NORMAL_ROUGHNESS))
#ifndef T3D_VT_TERRAIN_FEEDBACK_ALLOCATION
#error "M1 must provide T3D_VT_TERRAIN_FEEDBACK_ALLOCATION(logical_material_id) from the v2 terrain material publication"
#endif
#ifndef TERRAIN3D_VT_FEEDBACK_INC_GLSL
#error "terrain clipmap stage root must include vt/terrain_vt_feedback_inc.glslinc directly when fragment feedback is enabled"
#endif
#define T3D_VT_TERRAIN_FRAGMENT_FEEDBACK_ACTIVE
#endif
#endif // !T3D_WORLD_RASTER_MESH

layout(location = 0) in vec3 world_position;
layout(location = 1) in vec3 world_normal;
#ifndef T3D_WORLD_RASTER_MESH
layout(location = 2) flat in uint patch_tier;
layout(location = 3) flat in int terrain_region_layer;
layout(location = 4) in vec2 terrain_world_texel;
#endif
#ifdef T3D_FORWARD_MOTION
layout(location = 5) in vec4 current_screen_position;
layout(location = 6) in vec4 previous_screen_position;
#endif
#ifdef T3D_FORWARD_DEPTH
#ifdef T3D_FORWARD_NORMAL_ROUGHNESS
layout(location = 0) out vec4 out_normal_roughness;
#ifdef T3D_FORWARD_VOXEL_GI
layout(location = 1) out uvec2 out_voxel_gi;
#endif
#endif
#else
layout(location = 0) out vec4 out_color;
#ifdef T3D_FORWARD_SPECULAR
layout(location = 1) out vec4 out_specular;
#endif
#ifdef T3D_FORWARD_MOTION
layout(location = 2) out vec2 out_motion;
#endif
#endif

layout(set = 0, binding = 0, std140) uniform FrameData {
    mat4 view_projection[2];
    mat4 view_matrix;
    mat4 previous_view_projection[2];
    vec4 motion_jitter;
    vec4 motion_params;
    vec4 light_direction_ambient;
    vec4 light_color;
    vec4 terrain_params;
    vec4 mesh_params;
    vec4 target_params;
    vec4 camera_params[2];
    vec4 fog_params;
    vec4 fog_depth_params;
    vec4 displacement_params;
    vec4 instance_texture_mip_bias; // xyz: category mip bias; w: packed filter overrides
}
frame_data;

uint t3d_view_index() {
    return min(uint(gl_ViewIndex), 1u);
}
#ifndef T3D_WORLD_RASTER_MESH
struct TerrainRegionRecord {
    uint packed_physical_flags;
    uint megavt_allocation;
    uint megavt_generation;
    uint megavt_flags;
    vec4 megavt_world_to_uv;
};
layout(set = 0, binding = 1, std430) readonly buffer RegionMapData {
    TerrainRegionRecord region_map[];
};
layout(set = 0, binding = 2) uniform sampler2DArray height_maps;
layout(set = 0, binding = 3) uniform sampler2DArray control_maps;
layout(set = 0, binding = 4) uniform sampler2DArray color_maps;
layout(set = 0, binding = 5) uniform sampler2DArray albedo_maps;
layout(set = 0, binding = 6) uniform sampler2DArray normal_maps;
layout(set = 0, binding = 7) uniform sampler2DArray surface_maps;
layout(set = 0, binding = 12) uniform sampler2D displacement_buffer;
layout(set = 0, binding = 14) uniform sampler2DArray derived_maps;
layout(set = 0, binding = 15) uniform sampler2DArray middle_composite_maps;
layout(set = 0, binding = 16) uniform sampler2DArray middle_height_maps;
layout(set = 0, binding = 17) uniform sampler2D middle_height_region_map;
layout(set = 0, binding = 18) uniform sampler2D far_height_map;
layout(set = 0, binding = 19) uniform sampler2D far_color_map;
layout(set = 0, binding = 20) uniform sampler2DArray far_albedo_maps;
layout(set = 0, binding = 21) uniform sampler2D world_noise_cache;
layout(set = 0, binding = 22) uniform sampler2D macro_noise_texture;

struct EditorDecal {
    vec4 transform; // world position.xy, size, rotation
    vec4 color;
    uvec4 state; // visible, part flags, padding
};
struct EditorOverlayConfig {
    EditorDecal decals[3];
    vec4 heightmap_contour; // black height, white height, interval, thickness
    vec4 contour_color;
    vec4 instancer_grid; // cell size, padding
};
layout(set = 0, binding = 23, std430) readonly buffer EditorOverlayBuffer {
    EditorOverlayConfig editor_overlay;
};
layout(set = 0, binding = 24) uniform sampler2D editor_brush_texture;
layout(set = 0, binding = 25) uniform sampler2DArray terrain_shadow_masks;
#endif // !T3D_WORLD_RASTER_MESH


struct TerrainVTAllocation {
    uint base_page;
    uint page_count;
    uint packed_mip0_extent;
    uint packed_mip_count_flags;
    uint tail_index;
    uint generation;
    uint content_id;
    uint reserved;
};
struct TerrainVTPageEntry {
    uint physical_slot;
    uint parent_page;
    uint generation;
    uint packed_resolved_mip_flags;
};
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_ALLOCATION_BINDING, std430) readonly buffer TerrainVTAllocationBuffer {
    TerrainVTAllocation terrain_vt_allocations[];
};
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_PAGE_TABLE_BINDING, std430) readonly buffer TerrainVTPageTableBuffer {
    TerrainVTPageEntry terrain_vt_page_table[];
};
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_ALBEDO_BINDING) uniform sampler2DArray terrain_vt_albedo_bank0;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_NORMAL_BINDING) uniform sampler2DArray terrain_vt_normal_bank0;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_SURFACE_BINDING) uniform sampler2DArray terrain_vt_surface_bank0;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_HEIGHT_BINDING) uniform sampler2DArray terrain_vt_height_bank0;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET,
    binding = T3D_TERRAIN_VT_TAIL_METADATA_BINDING,
    std430) readonly buffer TerrainVTTailMetadataBuffer {
    T3DVTTailMetadata terrain_vt_tails[];
};
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_ALBEDO_TAIL_BINDING) uniform sampler2D terrain_vt_albedo_tail;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_NORMAL_TAIL_BINDING) uniform sampler2D terrain_vt_normal_tail;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_SURFACE_TAIL_BINDING) uniform sampler2D terrain_vt_surface_tail;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_HEIGHT_TAIL_BINDING) uniform sampler2D terrain_vt_height_tail;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_MIP_LAYOUT_BINDING, std430) readonly buffer TerrainVTMipLayoutBuffer {
    T3DVTMipLayout terrain_vt_mip_layouts[];
};

// The stage root includes the resolver body after this fragment has declared
// its VT resources. Keeping only the prototype here avoids a nested filesystem
// include, which Godot 4.7.2 does not expand.
bool t3d_vt_resolve_page_core(
    uint allocationId, uint requestedPage, uint requestedMip, uint allocationCount, uint pageCount, out T3DVTResolveResult result);

#ifndef T3D_WORLD_RASTER_MESH
struct MaterialLayer {
    vec4 color;
    vec4 pbr0;
    vec4 pbr1;
    vec2 displacement;
    uint physical_layer;
    uint flags;
    uint micro_vt_allocation;
    uint micro_vt_generation;
    uint micro_vt_flags;
    uint micro_vt_reserved;
};
layout(set = 0, binding = 8, std430) readonly buffer MaterialBuffer {
    MaterialLayer materials[];
};
layout(set = 0, binding = 11) uniform sampler2DArray displacement_maps;

struct TierMaterialConfig {
    uint sampling_mode;
    uint normal_mode;
    uint color_mode;
    uint surface_response;
    uint texture_surface_mode;
    uint lighting_model;
    uint detiling_mode;
    uint filtering;
    float authored_color_contribution;
    float wetness_contribution;
    float material_lod_bias;
    float quality_lod_offset;
};
struct MaterialConfig {
    uint feature_flags;
    uint debug_flags;
    uint output_flags;
    uint background_mode;
    uint projection_mode;
    uint tessellation_material_mode;
    uint world_noise_mode;
    uint texture_layer_counts;
    float displacement_sharpness;
    float blend_sharpness;
    float distant_normal_scale;
    float ground_level;
    float region_blend;
    float bias_distance;
    float mipmap_bias;
    float depth_blur;
    float auto_slope;
    float auto_height_reduction;
    uint auto_base_texture;
    uint auto_overlay_texture;
    uint dual_scale_texture;
    uint far_albedo_layer_count;
    float dual_scale_reduction;
    float tri_scale_reduction;
    float dual_scale_far;
    float dual_scale_near;
    float noise1_scale;
    float noise2_scale;
    float noise1_rotation_x;
    float noise1_rotation_y;
    float macro_variation1_r;
    float macro_variation1_g;
    float macro_variation1_b;
    float macro_variation_slope;
    float macro_variation2_r;
    float macro_variation2_g;
    float macro_variation2_b;
    float macro_variation_padding;
    float noise1_offset_x;
    float noise1_offset_y;
    float world_noise_cache_period;
    float world_noise_lod_distance;
    float world_noise_scale;
    float world_noise_height;
    uint world_noise_max_octaves;
    uint world_noise_min_octaves;
    uint world_noise_cache_enabled;
    uint world_noise_fragment_normals;
    float world_noise_offset_x;
    float world_noise_offset_y;
    float world_noise_offset_z;
    float world_noise_cache_max_lod;
    float silhouette_r;
    float silhouette_g;
    float silhouette_b;
    float silhouette_a;
    float contour_step;
    float editor_overlay_opacity;
    float reserved_2;
    float reserved_3;
    TierMaterialConfig tier[3];
};
layout(set = 0, binding = 13, std430) readonly buffer MaterialConfigBuffer {
    MaterialConfig material_config;
};
#endif // !T3D_WORLD_RASTER_MESH
