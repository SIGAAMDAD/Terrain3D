// P04 channel-directory shadow ABI is dormant; include it from a stage root on activation.
// Terrain clipmap fragment pipeline interface.
// Stage roots include this explicitly so reusable material evaluation cannot silently add descriptors or stage I/O.


#ifndef TERRAIN3D_MATERIAL_VT_CONTRACT_GLSLINC
#error "terrain_clipmap_fragment_interface.glslinc requires terrain_material_vt_contract.glslinc at the shader stage root"
#endif

#ifndef T3D_WORLD_RASTER_MESH
#define T3D_VT_TERRAIN_FEEDBACK_ALLOCATION(logical_material_id) (materials[T3D_CLIPMAP_MATERIAL_BASE + int(logical_material_id)].micro_vt_allocation)

#if defined(T3D_VT_FRAGMENT_FEEDBACK) && (!defined(T3D_FORWARD_DEPTH) || defined(T3D_FORWARD_NORMAL_ROUGHNESS))
#ifndef T3D_VT_TERRAIN_FEEDBACK_ALLOCATION
#error "M1 must provide T3D_VT_TERRAIN_FEEDBACK_ALLOCATION(logical_material_id) from the v2 terrain material publication"
#endif
#ifndef TERRAIN3D_VT_FEEDBACK_INC_GLSL
#error "terrain clipmap stage root must include vt/terrain_vt_feedback_inc.glslinc directly when fragment feedback is enabled"
#endif
#define T3D_VT_TERRAIN_FRAGMENT_FEEDBACK_ACTIVE
#endif
#endif // !T3D_WORLD_RASTER_MESH

// BR17: the screen-space variant reconstructs geometry varyings from an
// independently owned, reverse-Z visibility target. The raster variant is
// unchanged and the two interfaces cannot be active together.
#if defined(T3D_SCREEN_SPACE_SHADE_PASS) && T3D_SCREEN_SPACE_SHADE_PASS
vec3 world_position;
vec3 world_normal;
uint patch_tier;
int terrain_region_layer;
vec2 terrain_world_texel;
vec3 t3d_screen_space_world_ddx;
vec3 t3d_screen_space_world_ddy;
vec2 t3d_screen_space_texel_ddx;
vec2 t3d_screen_space_texel_ddy;
#else
layout(location = 0) in vec3 world_position;
layout(location = 1) in vec3 world_normal;
#ifndef T3D_WORLD_RASTER_MESH
layout(location = 2) flat in uint patch_tier;
layout(location = 3) flat in int terrain_region_layer;
layout(location = 4) in vec2 terrain_world_texel;
#endif
#ifdef T3D_FORWARD_MOTION
layout(location = 5) in vec4 current_screen_position;
layout(location = 6) in vec4 previous_screen_position;
#endif
#endif // !T3D_SCREEN_SPACE_SHADE_PASS
#if defined(T3D_SCREEN_SPACE_COVERAGE_PASS) && T3D_SCREEN_SPACE_COVERAGE_PASS
layout(location = 0) out vec4 t3d_screen_space_position_region;
layout(location = 1) out vec4 t3d_screen_space_normal_tier;
layout(location = 2) out vec4 t3d_screen_space_texel_dx;
layout(location = 3) out vec4 t3d_screen_space_texel_dy_world_dx;
layout(location = 4) out vec4 t3d_screen_space_world_dxz_dy;
#endif
#ifdef T3D_FORWARD_DEPTH
#ifdef T3D_FORWARD_NORMAL_ROUGHNESS
layout(location = 0) out vec4 out_normal_roughness;
#ifdef T3D_FORWARD_VOXEL_GI
layout(location = 1) out uvec2 out_voxel_gi;
#endif
#endif
#else
layout(location = 0) out vec4 out_color;
#ifdef T3D_FORWARD_SPECULAR
layout(location = 1) out vec4 out_specular;
#endif
#ifdef T3D_FORWARD_MOTION
layout(location = 2) out vec2 out_motion;
#endif
#endif


uint t3d_view_index() {
    return min(uint(gl_ViewIndex), 1u);
}
#ifndef T3D_WORLD_RASTER_MESH
layout(set = 0, binding = 1, std430) readonly buffer RegionMapData {
    TerrainRegionRecord region_map[];
};
layout(set = 0, binding = 2) uniform sampler2DArray height_maps;
layout(set = 0, binding = 3) uniform sampler2DArray control_maps;
layout(set = 0, binding = 4) uniform sampler2DArray color_maps;
layout(set = 0, binding = 5) uniform sampler2DArray albedo_maps;
layout(set = 0, binding = 6) uniform sampler2DArray normal_maps;
layout(set = 0, binding = 7) uniform sampler2DArray surface_maps;
layout(set = 0, binding = 12) uniform sampler2D displacement_buffer;
layout(set = 0, binding = 14) uniform sampler2DArray derived_maps;
layout(set = 0, binding = 15) uniform sampler2DArray middle_composite_maps;
layout(set = 0, binding = 16) uniform sampler2DArray middle_height_maps;
layout(set = 0, binding = 17) uniform sampler2D middle_height_region_map;
layout(set = 0, binding = 18) uniform sampler2D far_height_map;
layout(set = 0, binding = 19) uniform sampler2D far_color_map;
layout(set = 0, binding = 20) uniform sampler2DArray far_albedo_maps;
layout(set = 0, binding = 21) uniform sampler2D world_noise_cache;
layout(set = 0, binding = 22) uniform sampler2D macro_noise_texture;


layout(set = 0, binding = 24) uniform sampler2D editor_brush_texture;
layout(set = 0, binding = 25) uniform sampler2DArray terrain_shadow_masks;
#endif // !T3D_WORLD_RASTER_MESH


struct TerrainVTAllocation {
    uint base_page;
    uint page_count;
    uint packed_mip0_extent;
    uint packed_mip_count_flags;
    uint tail_index;
    uint generation;
    uint content_id;
    uint reserved;
};
struct TerrainVTPageEntry {
    uint physical_slot;
    uint parent_page;
    uint generation;
    uint packed_resolved_mip_flags;
};
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_ALLOCATION_BINDING, std430) readonly buffer TerrainVTAllocationBuffer {
    TerrainVTAllocation terrain_vt_allocations[];
};
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_PAGE_TABLE_BINDING, std430) readonly buffer TerrainVTPageTableBuffer {
    TerrainVTPageEntry terrain_vt_page_table[];
};
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_ALBEDO_BINDING) uniform sampler2DArray terrain_vt_albedo_bank0;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_NORMAL_BINDING) uniform sampler2DArray terrain_vt_normal_bank0;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_SURFACE_BINDING) uniform sampler2DArray terrain_vt_surface_bank0;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_HEIGHT_BINDING) uniform sampler2DArray terrain_vt_height_bank0;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET,
    binding = T3D_TERRAIN_VT_TAIL_METADATA_BINDING,
    std430) readonly buffer TerrainVTTailMetadataBuffer {
    T3DVTTailMetadata terrain_vt_tails[];
};
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_ALBEDO_TAIL_BINDING) uniform sampler2D terrain_vt_albedo_tail;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_NORMAL_TAIL_BINDING) uniform sampler2D terrain_vt_normal_tail;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_SURFACE_TAIL_BINDING) uniform sampler2D terrain_vt_surface_tail;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_HEIGHT_TAIL_BINDING) uniform sampler2D terrain_vt_height_tail;
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_MIP_LAYOUT_BINDING, std430) readonly buffer TerrainVTMipLayoutBuffer {
    T3DVTMipLayout terrain_vt_mip_layouts[];
};
#if defined(T3D_VT_RESIDENT_ANCESTOR_HINTS) && T3D_VT_RESIDENT_ANCESTOR_HINTS
layout(set = T3D_TERRAIN_VT_DESCRIPTOR_SET, binding = T3D_TERRAIN_VT_HINT_BINDING, std430) readonly buffer TerrainVTAncestorHints {
    T3DVTAncestorHint terrain_vt_ancestor_hints[];
};
#endif

// Independently versioned composed-result descriptor extension, cold-specialized.
// Legacy variants declare no additional bindings or descriptor requirements.
#ifdef T3D_CS_ACTIVE
struct T3DComposedGpuEntry {
    ivec2 world_page;
    uint mip;
    uint physical_slot;
    uint generation;
    uint device_generation;
    uint revision_lo;
    uint revision_hi;
    uint state;
    uint channels;
    uint reserved0;
    uint reserved1;
};
layout(set = T3D_CS_DESCRIPTOR_SET, binding = T3D_CS_PAGE_TABLE_BINDING, std430) readonly buffer T3DComposedPageLookup {
    T3DComposedGpuEntry terrain_cs_pages[];
};
layout(set = T3D_CS_DESCRIPTOR_SET, binding = T3D_CS_ALBEDO_BINDING) uniform sampler2DArray terrain_cs_albedo;
layout(set = T3D_CS_DESCRIPTOR_SET, binding = T3D_CS_NORMAL_BINDING) uniform sampler2DArray terrain_cs_normal;
layout(set = T3D_CS_DESCRIPTOR_SET, binding = T3D_CS_SURFACE_BINDING) uniform sampler2DArray terrain_cs_surface;
#endif

#ifndef T3D_WORLD_RASTER_MESH
layout(set = 0, binding = 8, std430) readonly buffer MaterialBuffer {
    MaterialLayer materials[];
};
layout(set = 0, binding = 11) uniform sampler2DArray displacement_maps;

layout(set = 0, binding = 13, std430) readonly buffer MaterialConfigBuffer {
    MaterialConfig material_configs[];
};
#define material_config material_configs[t3d_hot_records[T3D_HOT_INDEX].terrain_bases.x]
#endif // !T3D_WORLD_RASTER_MESH
